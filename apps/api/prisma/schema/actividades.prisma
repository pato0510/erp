/* CAL-002 — Calendario de Actividades schema. First table: activity_areas, the
   configurable lane catalog managed by MANAGER/ADMIN/SUPER_ADMIN (decision c). ASCII
   identifiers; Spanish display labels live in the UI. The platform invariant (RLS + audit
   trigger + app_user GRANT) ships in migration 20260715120000_add_activity_areas.

   COEXISTENCE DOCTRINE (record for future CC): ActivityArea deliberately coexists with
   RRHH's fixed AreaRRHH enum — DIFFERENT concepts (organizational belonging vs. the small,
   founder-configurable planning lane). No future ticket unifies them without an explicit
   founder decision (same class of trap as the VIEWER↔caja doctrine). */

model ActivityArea {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  color     String? // hex "#RRGGBB" for the lane/chip; the UI offers a fixed palette
  active    Boolean  @default(true)
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CAL-003 — RESOLVED (was the CAL-002 deferral): the relation now ships together with the
  // calendar_activities FK (areaId → activity_areas, onDelete: Restrict). Restrict is the DB
  // backstop for the "zero activities" pristine-delete guard enforced in AreasService.remove.
  activities CalendarActivity[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("activity_areas")
}

/* CAL-003 — the central calendar entity. Named CalendarActivity (not Activity — that table
 * is Comercial's, §2.0). Company-wide manual activities: single-day or multi-day ranges,
 * optional wall-clock startTime, an area lane, an optional assignee, a status machine and
 * free-text notes. RLS + audit trigger + app_user GRANT ship in migration
 * 20260715130000_add_calendar_activities (platform invariant). */
enum ActivityStatus {
  PENDIENTE
  EN_EJECUCION // CAL-008 — added BETWEEN PENDIENTE and HECHA; DB order must match this order.
  HECHA
  CANCELADA
}

/* CAL-014 — a LENS on the same row, not a machine: a SERVICIO is a manual service (a ranged
 * activity) that runs the SAME status machine as an ACTIVIDAD. It only segments the views. */
enum ActivityKind {
  ACTIVIDAD
  SERVICIO
}

model CalendarActivity {
  id         String         @id @default(uuid()) @db.Uuid
  companyId  String         @db.Uuid
  title      String
  areaId     String         @db.Uuid
  startDate  DateTime       @db.Date
  endDate    DateTime?      @db.Date
  startTime  String? // wall-clock "HH:mm" — a validated STRING, never a timestamp (§2.2 / f)
  assigneeId String?        @db.Uuid
  status     ActivityStatus @default(PENDIENTE)
  kind       ActivityKind   @default(ACTIVIDAD) // CAL-014 — view lens (ACTIVIDAD | SERVICIO)
  notes      String?
  createdBy  String         @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  area ActivityArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  // CAL-009 — the immutable bitácora. Named `logEntries`, NOT `notes`, because the `notes
  // String?` field above is the static description (they coexist by §1.6). Lands with the table.
  logEntries CalendarActivityNote[]

  @@index([companyId])
  @@index([companyId, startDate])
  @@map("calendar_activities")
}

/* CAL-009 / CAL-012 — the bitácora: dated entries per activity (the Comercial-timeline
 * discipline, §1.6). CAL-009 shipped this IMMUTABLE (no updatedAt, no edit/delete routes).
 * REVERSED by the founder 2026-07-22 (CAL-012): any activity WRITER may edit or delete ANY entry,
 * forever. `updatedAt` is PLAIN nullable (NOT @updatedAt) — set EXPLICITLY only in the edit path,
 * so a pristine entry stays null and the "editada" marker is truthful. The platform audit trigger
 * is the forensic layer: every UPDATE/DELETE preserves the prior content in audit_logs. CASCADE
 * with the activity. RLS + audit trigger + app_user GRANT shipped in 20260721130000; the
 * updatedAt column in 20260722120000_add_note_updatedat. */
model CalendarActivityNote {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  activityId String    @db.Uuid
  authorId   String    @db.Uuid // bare actor UUID; the display name is resolved via the members map
  text       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? // null = never edited; set EXPLICITLY in the edit path (NOT @updatedAt)

  activity CalendarActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([activityId])
  @@map("calendar_activity_notes")
}
