enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  ANALYST
  VIEWER
}

// ACCESS-001 (founder decision 2026-10-27, interim until real profiles exist):
// modules a membership is blocked from, applied in CaslAbilityFactory AFTER the
// role rules. SUPER_ADMIN/ADMIN are never restricted (UsersService enforces it).
enum AccessModule {
  FINANZAS
  RRHH
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  isActive           Boolean   @default(true)
  refreshTokenHash   String?
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  passwordChangedAt  DateTime? @db.Timestamp(3)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships   Membership[]
  notifications UserNotification[]
  employees     Employee[] // HR-003 — virtual back-relation; the FK lives on employees.userId (no column on users)

  @@map("users")
}

model Membership {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  companyId         String         @db.Uuid
  role              UserRole
  isActive          Boolean        @default(true)
  // ACCESS-001 — empty array = today's access. Validated against the role on write.
  restrictedModules AccessModule[] @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@map("memberships")
}
