enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_LINE
  OTHER
}

model BankAccount {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid
  name          String
  accountNumber String?
  type          AccountType
  currency      String      @default("CLP")
  bankName      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  balances    AccountBalance[]
  connections BankConnection[]

  @@unique([companyId, accountNumber])
  @@map("bank_accounts")
}

model AccountBalance {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  bankAccountId  String   @db.Uuid
  fiscalPeriodId String   @db.Uuid
  openingBalance Decimal  @db.Decimal(18, 2)
  closingBalance Decimal? @db.Decimal(18, 2)
  currency       String   @default("CLP")
  setBy          String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])

  @@unique([bankAccountId, fiscalPeriodId])
  @@map("account_balances")
}

enum CommitmentStatus {
  PENDING
  PAID
  CANCELLED
  /* OPS-033 — auto-generated commitment cleared because the
     underlying obligation was satisfied without a real cash
     payment (e.g. a document was renewed). Distinct from PAID so
     dashboards can tell true-paid from auto-fulfilled. */
  FULFILLED
}

model Commitment {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @db.Uuid
  fiscalPeriodId String           @db.Uuid
  counterpartyId String?          @db.Uuid
  categoryId     String?          @db.Uuid
  type           MovementType
  amount         Decimal          @db.Decimal(18, 2)
  currency       String           @default("CLP")
  dueDate        DateTime         @db.Date
  description    String
  status         CommitmentStatus @default(PENDING)
  paidAt         DateTime?
  paidBy         String?          @db.Uuid
  movementId     String?          @db.Uuid
  notes          String?
  /* OPS-033 — provenance for auto-generated commitments. Tracks
     which Operations event spawned this row so the corresponding
     auto-fulfillment hook can find it again on document/permit
     renewal. Manual commitments leave these null. */
  sourceType       String?
  sourceId         String?  @db.Uuid
  sourceMetadata   Json?
  isAutoGenerated  Boolean  @default(false)
  autoFulfilledAt  DateTime?
  autoFulfilledBy  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  fiscalPeriod FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id])
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])

  @@index([companyId, dueDate])
  @@index([companyId, sourceType, sourceId])
  @@map("commitments")
}

/* OPS-033 — cost templates per (documentType OR permitType). When
   the alert engine emits a renewal-imminent event, the listener
   looks up a matching template to figure out how much money to
   block in the cashflow projection. Exactly one of documentTypeId
   or permitTypeId is populated. */
model CommitmentTemplate {
  id                    String  @id @default(uuid()) @db.Uuid
  companyId             String  @db.Uuid

  documentTypeId        String? @db.Uuid
  permitTypeId          String? @db.Uuid

  categoryId            String  @db.Uuid
  description           String
  estimatedAmount       Decimal @db.Decimal(18, 2)
  currency              String  @default("CLP")
  daysBeforeExpiration  Int     @default(30)

  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             String   @db.Uuid

  category              Category @relation(fields: [categoryId], references: [id])

  @@index([companyId, documentTypeId])
  @@index([companyId, permitTypeId])
  @@map("commitment_templates")
}
