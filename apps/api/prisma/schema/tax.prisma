enum DocumentType {
  FACTURA_ELECTRONICA
  BOLETA_ELECTRONICA
  NOTA_CREDITO
  NOTA_DEBITO
  LIQUIDACION_FACTURA
  FACTURA_NO_AFECTA
}

enum DocumentDirection {
  EMITIDO
  RECIBIDO
}

enum TaxDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model TaxDocument {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  fiscalPeriodId String?           @db.Uuid
  type           DocumentType
  direction      DocumentDirection
  folio          Int
  issuerRut      String
  issuerName     String
  receiverRut    String
  receiverName   String
  issueDate      DateTime          @db.Date
  netAmount      Decimal           @db.Decimal(18, 2)
  taxAmount      Decimal           @db.Decimal(18, 2)
  totalAmount    Decimal           @db.Decimal(18, 2)
  currency       String            @default("CLP")
  status         TaxDocumentStatus @default(PENDING)
  externalId     String?
  xmlPath        String?
  pdfPath        String?
  metadata       Json?
  movementId     String?           @db.Uuid
  isReconciled   Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([companyId, type, folio, direction])
  @@index([companyId, fiscalPeriodId, direction])
  @@index([companyId, issuerRut])
  @@map("tax_documents")
}

model TaxSyncRun {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  fiscalPeriodId  String?           @db.Uuid
  status          SyncStatus        @default(PENDING)
  provider        String            @default("mock-sii")
  direction       DocumentDirection
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  documentsSynced Int               @default(0)
  errorMessage    String?
  createdAt       DateTime          @default(now())

  @@index([companyId, fiscalPeriodId])
  @@map("tax_sync_runs")
}
