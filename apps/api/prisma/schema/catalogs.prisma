enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  name        String
  type        CategoryType
  description String?
  color       String? // Hex color e.g. "#4CAF50"
  icon        String? // Icon name for UI
  isActive    Boolean      @default(true)
  parentId    String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  movements   Movement[]
  commitments Commitment[]

  @@unique([companyId, name, type])
  @@map("categories")
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  BANK
  GOVERNMENT
  OTHER
}

model Counterparty {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  name      String
  type      CounterpartyType
  taxId     String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean          @default(true)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  movements   Movement[]
  commitments Commitment[]

  @@unique([companyId, taxId])
  @@map("counterparties")
}

model CostCenter {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements Movement[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

enum PeriodStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

model FiscalPeriod {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  name      String
  year      Int
  month     Int
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedBy  String?      @db.Uuid
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  movements       Movement[]
  accountBalances AccountBalance[]
  commitments     Commitment[]

  @@unique([companyId, year, month])
  @@map("fiscal_periods")
}
