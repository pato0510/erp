/* MKT-002 — Marketing schema. First Marketing table: campaigns. Campaign OWNS its
   lifecycle (write = MANAGER/ADMIN/SUPER_ADMIN; ACCOUNTANT reads budget/spend — the
   MKT-001 CASL matrix). Enums use ASCII-only members (Prisma enum Ñ gotcha); display
   labels live in the UI layer. The platform invariant (RLS + audit trigger + app_user
   GRANT) ships in migration 20260710120000_add_campaigns.

   Money is never stored derived: `spent = Σ expenses.amount` and the over-budget
   condition are computed live (MKT-005) — no rollup columns here.

   Relations (both now materialized with their FKs, so the schema matches the DB):
     - expenses MarketingExpense[]  → MKT-005 (marketing_expenses table + campaignId FK).
     - accounts Account[]           → MKT-006 (accounts.sourceCampaignId promoted to a
       real FK referencing campaigns(id), ON DELETE SET NULL). The FK lives on the
       accounts side (comercial.prisma); here it is just the back-relation. */

enum CampaignChannel {
  FERIA_EVENTO
  REDES_SOCIALES
  GOOGLE_ADS
  EMAIL
  REFERIDOS
  LICITACION
  OTRO
}

enum CampaignStatus {
  BORRADOR
  ACTIVA
  PAUSADA
  FINALIZADA
  CANCELADA
}

model Campaign {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  name         String
  description  String?
  channel      CampaignChannel
  status       CampaignStatus  @default(BORRADOR)
  startDate    DateTime?       @db.Date
  endDate      DateTime?       @db.Date
  budgetAmount Decimal?        @db.Decimal(18, 2)
  ownerId      String?         @db.Uuid
  notes        String?
  createdBy    String          @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // MKT-005 — dependent expense ledger (onDelete: Cascade on the FK side).
  expenses MarketingExpense[]
  // MKT-006 — accounts attributed to this campaign (FK accounts.sourceCampaignId,
  // ON DELETE SET NULL — deleting a campaign only clears attribution, never the account).
  accounts Account[]

  @@index([companyId])
  @@index([status])
  @@map("campaigns")
}

/* MKT-005 — per-campaign marketing expense ledger. INFORMATIONAL ONLY: real money
   lives in Finanzas (invoice + approval + SII sync). This table NEVER writes to
   Finance — no Movement, no Commitment, no domain event (Part 1 §2.2 / §4), so there
   is zero double-count risk by construction. Amounts are NET of IVA (decision b) so
   ROI compares like-for-like against a quote's netAmount. `vendorName` is free text —
   deliberately NOT an FK to counterparties. Dependent child of a campaign
   (onDelete: Cascade), same pattern as quote_lines. The platform invariant (RLS +
   audit trigger + app_user GRANT) ships in migration 20260713120000_add_marketing_expenses. */
model MarketingExpense {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  campaignId  String   @db.Uuid
  expenseDate DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(18, 2)
  vendorName  String?
  notes       String?
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([campaignId])
  @@map("marketing_expenses")
}

/* MKT-008 — monthly digital-presence snapshot (one row per company per month; the wide
   model — one column per metric). Manual monthly entry in V1 (API integrations are V2).
   NO relations to any other model. `period` is always the FIRST day of the month, UTC
   (normalized in the service). All three metrics are nullable — record what you have; at
   least one must be present on a write (enforced in the service). The platform invariant
   (RLS + audit trigger + app_user GRANT) ships in migration
   20260714120000_add_presence_snapshots. */
model PresenceSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  period             DateTime @db.Date
  webVisits          Int?
  linkedinFollowers  Int?
  googleProfileViews Int?
  notes              String?
  createdBy          String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@map("presence_snapshots")
}
