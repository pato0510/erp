enum AssetCategory {
  EQUIPMENT
  VEHICLE
  TOOL
  INFRASTRUCTURE
}

enum AssetStatus {
  OPERATIONAL
  WITH_OBSERVATIONS
  NON_OPERATIONAL
  IN_MAINTENANCE
  BLOCKED_DOCUMENTAL
  BLOCKED_PERMIT
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

model Location {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  name             String
  code             String?
  parentLocationId String?  @db.Uuid
  address          String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String   @db.Uuid

  parent   Location?          @relation("LocationTree", fields: [parentLocationId], references: [id])
  children Location[]         @relation("LocationTree")
  assets   OperationalAsset[]

  @@unique([companyId, code])
  @@index([companyId, parentLocationId])
  @@map("locations")
}

model AssetType {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  name        String
  category    AssetCategory
  description String?
  icon        String?
  color       String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subtypes     AssetSubtype[]
  assets       OperationalAsset[]
  requirements DocumentRequirement[]

  @@unique([companyId, name])
  @@map("asset_types")
}

model AssetSubtype {
  id             String   @id @default(uuid()) @db.Uuid
  assetTypeId    String   @db.Uuid
  name           String
  specifications Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assetType    AssetType             @relation(fields: [assetTypeId], references: [id])
  assets       OperationalAsset[]
  requirements DocumentRequirement[]

  @@unique([assetTypeId, name])
  @@map("asset_subtypes")
}

model OperationalAsset {
  id                String      @id @default(uuid()) @db.Uuid
  companyId         String      @db.Uuid
  assetTypeId       String      @db.Uuid
  assetSubtypeId    String?     @db.Uuid
  locationId        String?     @db.Uuid
  parentAssetId     String?     @db.Uuid
  code              String
  name              String
  description       String?
  serialNumber      String?
  manufacturer      String?
  model             String?
  acquisitionDate   DateTime?   @db.Date
  acquisitionCost   Decimal?    @db.Decimal(18, 2)
  status            AssetStatus @default(OPERATIONAL)
  statusReason      String?
  statusChangedAt   DateTime?
  photoPath         String?
  photoData         Bytes?
  photoMimeType     String?
  dynamicAttributes Json        @default("{}")
  tags              String[]    @default([])
  assignedToUserId  String?     @db.Uuid
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String      @db.Uuid

  assetType    AssetType             @relation(fields: [assetTypeId], references: [id])
  assetSubtype AssetSubtype?         @relation(fields: [assetSubtypeId], references: [id])
  location     Location?             @relation(fields: [locationId], references: [id])
  parent       OperationalAsset?     @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  children     OperationalAsset[]    @relation("AssetHierarchy")
  vehicle        Vehicle?
  requirements   DocumentRequirement[]
  documents      DocumentRecord[]
  alertInstances AlertInstance[]
  statusChanges  AssetStatusChange[]
  exceptions     AssetException[]

  @@unique([companyId, code])
  @@index([companyId, assetTypeId])
  @@index([companyId, locationId])
  @@index([companyId, status])
  @@index([companyId, parentAssetId])
  @@map("operational_assets")
}

model Vehicle {
  id                String    @id @default(uuid()) @db.Uuid
  assetId           String    @unique @db.Uuid
  licensePlate      String
  vin               String?
  year              Int?
  currentKilometers Int       @default(0)
  lastKmUpdate      DateTime?
  fuelType          FuelType
  registrationDate  DateTime? @db.Date
  color             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([licensePlate])
  @@map("vehicles")
}

enum DocumentCategory {
  LEGAL
  SAFETY
  OPERATIONAL
  FINANCIAL
  TECHNICAL
  ADMINISTRATIVE
}

enum DocumentCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/* Named OperationalDocumentType to avoid a name collision with the existing
   tax `DocumentType` enum (FACTURA_ELECTRONICA, BOLETA_ELECTRONICA, ...).
   Table name stays `document_types`. */
model OperationalDocumentType {
  id                      String              @id @default(uuid()) @db.Uuid
  companyId               String              @db.Uuid
  name                    String
  code                    String
  category                DocumentCategory
  hasExpiration           Boolean             @default(false)
  defaultValidityDays     Int?
  criticality             DocumentCriticality
  blocksOperation         Boolean             @default(false)
  alertDaysBefore         Int                 @default(30)
  criticalAlertDaysBefore Int                 @default(7)
  description             String?
  icon                    String?
  color                   String?
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  createdBy               String              @db.Uuid

  requirements   DocumentRequirement[]
  records        DocumentRecord[]
  alertRules     AlertRule[]
  alertInstances AlertInstance[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, category])
  @@map("document_types")
}

enum DocumentRecordStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACED
  ARCHIVED
}

model DocumentRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @db.Uuid
  documentTypeId       String               @db.Uuid
  assetId              String               @db.Uuid
  fileName             String
  mimeType             String
  fileSize             Int
  filePath             String?
  fileData             Bytes?
  issueDate            DateTime?            @db.Date
  expirationDate       DateTime?            @db.Date
  status               DocumentRecordStatus @default(DRAFT)
  statusReason         String?
  statusChangedAt      DateTime?
  statusChangedBy      String?              @db.Uuid
  uploadedBy           String               @db.Uuid
  approvedBy           String?              @db.Uuid
  approvedAt           DateTime?
  rejectedBy           String?              @db.Uuid
  rejectedAt           DateTime?
  version              Int                  @default(1)
  replacedByDocumentId String?              @db.Uuid
  notes                String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  documentType   OperationalDocumentType @relation(fields: [documentTypeId], references: [id])
  asset          OperationalAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  replacedBy     DocumentRecord?         @relation("DocumentSupersession", fields: [replacedByDocumentId], references: [id])
  replaces       DocumentRecord[]        @relation("DocumentSupersession")
  alertInstances AlertInstance[]

  @@index([companyId, assetId])
  @@index([companyId, documentTypeId])
  @@index([companyId, status])
  @@index([companyId, expirationDate])
  @@map("document_records")
}

model DocumentRequirement {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  documentTypeId String   @db.Uuid
  assetTypeId    String?  @db.Uuid
  assetSubtypeId String?  @db.Uuid
  assetId        String?  @db.Uuid
  isMandatory    Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String   @db.Uuid

  documentType OperationalDocumentType @relation(fields: [documentTypeId], references: [id])
  assetType    AssetType?              @relation(fields: [assetTypeId], references: [id])
  assetSubtype AssetSubtype?     @relation(fields: [assetSubtypeId], references: [id])
  asset        OperationalAsset? @relation(fields: [assetId], references: [id])

  @@index([companyId, documentTypeId])
  @@index([companyId, assetTypeId])
  @@index([companyId, assetSubtypeId])
  @@index([companyId, assetId])
  @@map("document_requirements")
}

/* OPS-018 — per-document-type alert rule. When `documentTypeId` is null
   the row is a global override applicable to every type whose default
   would otherwise fire at the same threshold; when set, it's specific to
   that document type. The resolver in AlertRulesService merges these
   rows with dynamic defaults derived from
   OperationalDocumentType.alertDaysBefore / criticalAlertDaysBefore. */
model AlertRule {
  id                          String        @id @default(uuid()) @db.Uuid
  companyId                   String        @db.Uuid
  documentTypeId              String?       @db.Uuid
  name                        String
  isActive                    Boolean       @default(true)
  daysBeforeExpiration        Int
  severity                    AlertSeverity
  channels                    Json          @default("{\"inApp\":true,\"email\":false}")
  targetRoles                 String[]      @default([])
  notifyAssignedUser          Boolean       @default(true)
  notifyOperationalSupervisor Boolean       @default(false)
  escalateAfterDays           Int?
  escalateToRoles             String[]      @default([])
  description                 String?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  createdBy                   String        @db.Uuid

  documentType   OperationalDocumentType? @relation(fields: [documentTypeId], references: [id])
  alertInstances AlertInstance[]

  @@index([companyId, documentTypeId, isActive])
  @@index([companyId, daysBeforeExpiration])
  @@map("alert_rules")
}

/* OPS-019 — concrete alert generated by the daily engine for a specific
   (asset, documentType) pair. The unique constraint dedupes within a
   single (status, threshold) pair so the engine is naturally idempotent
   on repeated runs — once a row exists in ACTIVE state for a threshold,
   subsequent runs find it and skip. Resolving/dismissing flips status,
   freeing the slot for a new ACTIVE row if conditions re-trigger. */
enum AlertTriggerType {
  EXPIRING_SOON
  EXPIRED
  MISSING
  BLOCKING
}

enum AlertInstanceStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
  DISMISSED
}

model AlertInstance {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  alertRuleId          String?             @db.Uuid
  documentTypeId       String              @db.Uuid
  assetId              String              @db.Uuid
  documentRecordId     String?             @db.Uuid
  triggerType          AlertTriggerType
  severity             AlertSeverity
  /* Rule threshold that fired this row (e.g. 30, 7, 0). For MISSING/
     EXPIRED triggers without a matching rule the engine stores the
     synthesized threshold (0) so the unique key has a stable value. */
  daysBeforeExpiration Int
  triggeredAt          DateTime            @default(now())
  expirationDate       DateTime?           @db.Date
  status               AlertInstanceStatus @default(ACTIVE)
  acknowledgedBy       String?             @db.Uuid
  acknowledgedAt       DateTime?
  resolvedBy           String?             @db.Uuid
  resolvedAt           DateTime?
  resolvedReason       String?
  escalatedAt          DateTime?
  notifiedRoles        String[]            @default([])
  notifiedUsers        String[]            @default([]) @db.Uuid
  title                String
  message              String?
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  alertRule      AlertRule?              @relation(fields: [alertRuleId], references: [id])
  documentType   OperationalDocumentType @relation(fields: [documentTypeId], references: [id])
  asset          OperationalAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  documentRecord DocumentRecord?         @relation(fields: [documentRecordId], references: [id])
  notifications  UserNotification[]

  @@unique([companyId, assetId, documentTypeId, triggerType, daysBeforeExpiration, status])
  @@index([companyId, status, triggeredAt])
  @@index([companyId, assetId, status])
  @@index([companyId, severity, status])
  @@map("alert_instances")
}

/* OPS-018 — singleton-per-company. Houses the global defaults that the
   alert resolver falls back to when no AlertRule overrides apply.
   `enableAutoBlocking` is also consumed by OPS-020. */
model CompanyAlertSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  companyId                   String   @unique @db.Uuid
  defaultDaysBefore           Int      @default(30)
  defaultCriticalDaysBefore   Int      @default(7)
  defaultBlockingDaysBefore   Int      @default(0)
  enableAutoBlocking          Boolean  @default(true)
  enableEmailNotifications    Boolean  @default(false)
  defaultEscalationDays       Int      @default(7)
  updatedAt                   DateTime @updatedAt
  updatedBy                   String   @db.Uuid

  @@map("company_alert_settings")
}

/* OPS-020 — audit trail of every status transition. Distinguishes
   manual edits from system-driven AUTO_BLOCK / AUTO_UNBLOCK. The
   triggering doc-type IDs and alert IDs are kept as flat arrays so a
   single row can describe a multi-document trigger without joining
   another table. */
enum StatusChangeType {
  MANUAL
  AUTO_BLOCK
  AUTO_UNBLOCK
  EXCEPTION_GRANTED
  EXCEPTION_EXPIRED
}

/* OPS-022 — per-user notification inbox. RLS enforces a strict
   companyId AND userId match so notifications stay strictly personal
   even within the same tenant. The source columns let one inbox row
   point back to an alert, an asset block, an escalation, etc. */
enum NotificationSourceType {
  ALERT_INSTANCE
  ASSET_BLOCKED
  ESCALATION
  DOCUMENT_REJECTED
  DOCUMENT_APPROVED
  EXCEPTION_REQUESTED
  EXCEPTION_GRANTED
  GENERAL
}

model UserNotification {
  id              String                 @id @default(uuid()) @db.Uuid
  companyId       String                 @db.Uuid
  userId          String                 @db.Uuid
  alertInstanceId String?                @db.Uuid
  sourceType      NotificationSourceType
  title           String
  message         String?
  severity        AlertSeverity
  linkPath        String?
  icon            String?
  isRead          Boolean                @default(false)
  readAt          DateTime?
  isDismissed     Boolean                @default(false)
  dismissedAt     DateTime?
  createdAt       DateTime               @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertInstance AlertInstance? @relation(fields: [alertInstanceId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, isRead, createdAt])
  @@index([companyId, userId, isDismissed])
  @@index([alertInstanceId])
  @@map("user_notifications")
}

model AssetStatusChange {
  id                          String           @id @default(uuid()) @db.Uuid
  companyId                   String           @db.Uuid
  assetId                     String           @db.Uuid
  previousStatus              AssetStatus
  newStatus                   AssetStatus
  changeType                  StatusChangeType
  reason                      String?
  changedBy                   String?          @db.Uuid
  triggeringDocumentTypeIds   String[]         @default([]) @db.Uuid
  triggeringAlertInstanceIds  String[]         @default([]) @db.Uuid
  metadata                    Json             @default("{}")
  createdAt                   DateTime         @default(now())

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, assetId, createdAt])
  @@index([companyId, changeType])
  @@map("asset_status_changes")
}

/* OPS-023 — temporary exception that lifts BLOCKED_DOCUMENTAL on an
   asset for a bounded period. The lifecycle is:
   PENDING → APPROVED → (EXPIRED via cron OR REVOKED via admin)
   PENDING → REJECTED. previousStatus snapshots what to revert to so
   the cron can restore the original state cleanly. */
enum ExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model AssetException {
  id                        String          @id @default(uuid()) @db.Uuid
  companyId                 String          @db.Uuid
  assetId                   String          @db.Uuid
  requestedBy               String          @db.Uuid
  requestedReason           String
  requestedAt               DateTime        @default(now())
  requestedDocumentTypeIds  String[]        @default([]) @db.Uuid
  status                    ExceptionStatus @default(PENDING)
  approvedBy                String?         @db.Uuid
  approvedReason            String?
  approvedAt                DateTime?
  rejectedBy                String?         @db.Uuid
  rejectedReason            String?
  rejectedAt                DateTime?
  validFrom                 DateTime?
  validUntil                DateTime?
  previousStatus            AssetStatus?
  /* Internal flag set true once the cron has handled expiration so the
     row isn't re-processed. We still flip status to EXPIRED — this is
     a belt-and-braces guard against re-runs. */
  expiresHandled            Boolean         @default(false)
  revokedBy                 String?         @db.Uuid
  revokedReason             String?
  revokedAt                 DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, status, validUntil])
  @@index([companyId, assetId, status])
  @@map("asset_exceptions")
}
