enum AssetCategory {
  EQUIPMENT
  VEHICLE
  TOOL
  INFRASTRUCTURE
}

enum AssetStatus {
  OPERATIONAL
  WITH_OBSERVATIONS
  NON_OPERATIONAL
  IN_MAINTENANCE
  BLOCKED_DOCUMENTAL
  BLOCKED_PERMIT
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

model Location {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  name             String
  code             String?
  parentLocationId String?  @db.Uuid
  address          String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String   @db.Uuid

  parent         Location?          @relation("LocationTree", fields: [parentLocationId], references: [id])
  children       Location[]         @relation("LocationTree")
  assets         OperationalAsset[]
  permits        Permit[]
  workPermits    WorkPermit[]
  alertInstances AlertInstance[]

  @@unique([companyId, code])
  @@index([companyId, parentLocationId])
  @@map("locations")
}

model AssetType {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  name        String
  category    AssetCategory
  description String?
  icon        String?
  color       String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subtypes     AssetSubtype[]
  assets       OperationalAsset[]
  requirements DocumentRequirement[]

  @@unique([companyId, name])
  @@map("asset_types")
}

model AssetSubtype {
  id             String   @id @default(uuid()) @db.Uuid
  assetTypeId    String   @db.Uuid
  name           String
  specifications Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assetType    AssetType             @relation(fields: [assetTypeId], references: [id])
  assets       OperationalAsset[]
  requirements DocumentRequirement[]

  @@unique([assetTypeId, name])
  @@map("asset_subtypes")
}

model OperationalAsset {
  id                String      @id @default(uuid()) @db.Uuid
  companyId         String      @db.Uuid
  assetTypeId       String      @db.Uuid
  assetSubtypeId    String?     @db.Uuid
  locationId        String?     @db.Uuid
  parentAssetId     String?     @db.Uuid
  code              String
  name              String
  description       String?
  serialNumber      String?
  manufacturer      String?
  model             String?
  acquisitionDate   DateTime?   @db.Date
  acquisitionCost   Decimal?    @db.Decimal(18, 2)
  status            AssetStatus @default(OPERATIONAL)
  statusReason      String?
  statusChangedAt   DateTime?
  photoPath         String?
  photoData         Bytes?
  photoMimeType     String?
  dynamicAttributes Json        @default("{}")
  tags              String[]    @default([])
  assignedToUserId  String?     @db.Uuid
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String      @db.Uuid

  // OPS-035 — public scan via QR. `qrToken` is a 32-char base64url
  // string (not a UUID) so it stays compact when printed and is
  // collision-resistant. Null until the first generation; rotated
  // by ADMIN to revoke leaked stickers.
  qrToken         String?   @unique
  qrGeneratedAt   DateTime?
  qrLastScannedAt DateTime?
  qrScanCount     Int       @default(0)

  assetType    AssetType             @relation(fields: [assetTypeId], references: [id])
  assetSubtype AssetSubtype?         @relation(fields: [assetSubtypeId], references: [id])
  location     Location?             @relation(fields: [locationId], references: [id])
  parent       OperationalAsset?     @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  children     OperationalAsset[]    @relation("AssetHierarchy")
  vehicle        Vehicle?
  requirements   DocumentRequirement[]
  documents      DocumentRecord[]
  alertInstances AlertInstance[]
  statusChanges  AssetStatusChange[]
  exceptions     AssetException[]
  permits        Permit[]
  workPermits    WorkPermit[]

  @@unique([companyId, code])
  @@index([companyId, assetTypeId])
  @@index([companyId, locationId])
  @@index([companyId, status])
  @@index([companyId, parentAssetId])
  @@map("operational_assets")
}

model Vehicle {
  id                String    @id @default(uuid()) @db.Uuid
  assetId           String    @unique @db.Uuid
  licensePlate      String
  vin               String?
  year              Int?
  currentKilometers Int       @default(0)
  lastKmUpdate      DateTime?
  fuelType          FuelType
  registrationDate  DateTime? @db.Date
  color             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([licensePlate])
  @@map("vehicles")
}

enum DocumentCategory {
  LEGAL
  SAFETY
  OPERATIONAL
  FINANCIAL
  TECHNICAL
  ADMINISTRATIVE
}

enum DocumentCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/* Named OperationalDocumentType to avoid a name collision with the existing
   tax `DocumentType` enum (FACTURA_ELECTRONICA, BOLETA_ELECTRONICA, ...).
   Table name stays `document_types`. */
model OperationalDocumentType {
  id                      String              @id @default(uuid()) @db.Uuid
  companyId               String              @db.Uuid
  name                    String
  code                    String
  category                DocumentCategory
  hasExpiration           Boolean             @default(false)
  defaultValidityDays     Int?
  criticality             DocumentCriticality
  blocksOperation         Boolean             @default(false)
  alertDaysBefore         Int                 @default(30)
  criticalAlertDaysBefore Int                 @default(7)
  description             String?
  icon                    String?
  color                   String?
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  createdBy               String              @db.Uuid

  requirements   DocumentRequirement[]
  records        DocumentRecord[]
  alertRules     AlertRule[]
  alertInstances AlertInstance[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, category])
  @@map("document_types")
}

enum DocumentRecordStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACED
  ARCHIVED
}

model DocumentRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @db.Uuid
  documentTypeId       String               @db.Uuid
  assetId              String               @db.Uuid
  fileName             String
  mimeType             String
  fileSize             Int
  filePath             String?
  fileData             Bytes?
  issueDate            DateTime?            @db.Date
  expirationDate       DateTime?            @db.Date
  status               DocumentRecordStatus @default(DRAFT)
  statusReason         String?
  statusChangedAt      DateTime?
  statusChangedBy      String?              @db.Uuid
  uploadedBy           String               @db.Uuid
  approvedBy           String?              @db.Uuid
  approvedAt           DateTime?
  rejectedBy           String?              @db.Uuid
  rejectedAt           DateTime?
  version              Int                  @default(1)
  replacedByDocumentId String?              @db.Uuid
  notes                String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  documentType   OperationalDocumentType @relation(fields: [documentTypeId], references: [id])
  asset          OperationalAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  replacedBy     DocumentRecord?         @relation("DocumentSupersession", fields: [replacedByDocumentId], references: [id])
  replaces       DocumentRecord[]        @relation("DocumentSupersession")
  alertInstances AlertInstance[]

  @@index([companyId, assetId])
  @@index([companyId, documentTypeId])
  @@index([companyId, status])
  @@index([companyId, expirationDate])
  @@map("document_records")
}

model DocumentRequirement {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  documentTypeId String   @db.Uuid
  assetTypeId    String?  @db.Uuid
  assetSubtypeId String?  @db.Uuid
  assetId        String?  @db.Uuid
  isMandatory    Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String   @db.Uuid

  documentType OperationalDocumentType @relation(fields: [documentTypeId], references: [id])
  assetType    AssetType?              @relation(fields: [assetTypeId], references: [id])
  assetSubtype AssetSubtype?     @relation(fields: [assetSubtypeId], references: [id])
  asset        OperationalAsset? @relation(fields: [assetId], references: [id])

  @@index([companyId, documentTypeId])
  @@index([companyId, assetTypeId])
  @@index([companyId, assetSubtypeId])
  @@index([companyId, assetId])
  @@map("document_requirements")
}

/* OPS-018 — per-document-type alert rule. When `documentTypeId` is null
   the row is a global override applicable to every type whose default
   would otherwise fire at the same threshold; when set, it's specific to
   that document type. The resolver in AlertRulesService merges these
   rows with dynamic defaults derived from
   OperationalDocumentType.alertDaysBefore / criticalAlertDaysBefore. */
model AlertRule {
  id                          String        @id @default(uuid()) @db.Uuid
  companyId                   String        @db.Uuid
  documentTypeId              String?       @db.Uuid
  name                        String
  isActive                    Boolean       @default(true)
  daysBeforeExpiration        Int
  severity                    AlertSeverity
  channels                    Json          @default("{\"inApp\":true,\"email\":false}")
  targetRoles                 String[]      @default([])
  notifyAssignedUser          Boolean       @default(true)
  notifyOperationalSupervisor Boolean       @default(false)
  escalateAfterDays           Int?
  escalateToRoles             String[]      @default([])
  description                 String?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  createdBy                   String        @db.Uuid

  documentType   OperationalDocumentType? @relation(fields: [documentTypeId], references: [id])
  alertInstances AlertInstance[]

  @@index([companyId, documentTypeId, isActive])
  @@index([companyId, daysBeforeExpiration])
  @@map("alert_rules")
}

/* OPS-019 — concrete alert generated by the daily engine for a specific
   (asset, documentType) pair. The unique constraint dedupes within a
   single (status, threshold) pair so the engine is naturally idempotent
   on repeated runs — once a row exists in ACTIVE state for a threshold,
   subsequent runs find it and skip. Resolving/dismissing flips status,
   freeing the slot for a new ACTIVE row if conditions re-trigger. */
enum AlertTriggerType {
  EXPIRING_SOON
  EXPIRED
  MISSING
  BLOCKING
}

enum AlertInstanceStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
  DISMISSED
}

model AlertInstance {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  alertRuleId          String?             @db.Uuid
  /* Document-side reference (Sprint 4). Optional from OPS-024
     onwards because permit-driven alerts use the parallel
     permitId/permitTypeId pair instead. */
  documentTypeId       String?             @db.Uuid
  /* Asset is now nullable too — permits can be attached to a
     Location with no asset, in which case the engine still tracks
     expiration but stores locationId rather than assetId. */
  assetId              String?             @db.Uuid
  documentRecordId     String?             @db.Uuid
  /* OPS-024 — permit-side references. Either (documentTypeId,
     documentRecordId) OR (permitTypeId, permitId) is populated for a
     given alert; the application enforces this rather than the DB. */
  permitTypeId         String?             @db.Uuid
  permitId             String?             @db.Uuid
  locationId           String?             @db.Uuid
  triggerType          AlertTriggerType
  severity             AlertSeverity
  /* Rule threshold that fired this row (e.g. 30, 7, 0). For MISSING/
     EXPIRED triggers without a matching rule the engine stores the
     synthesized threshold (0) so the unique key has a stable value. */
  daysBeforeExpiration Int
  triggeredAt          DateTime            @default(now())
  expirationDate       DateTime?           @db.Date
  status               AlertInstanceStatus @default(ACTIVE)
  acknowledgedBy       String?             @db.Uuid
  acknowledgedAt       DateTime?
  resolvedBy           String?             @db.Uuid
  resolvedAt           DateTime?
  resolvedReason       String?
  escalatedAt          DateTime?
  notifiedRoles        String[]            @default([])
  notifiedUsers        String[]            @default([]) @db.Uuid
  title                String
  message              String?
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  alertRule      AlertRule?               @relation(fields: [alertRuleId], references: [id])
  documentType   OperationalDocumentType? @relation(fields: [documentTypeId], references: [id])
  asset          OperationalAsset?        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  documentRecord DocumentRecord?          @relation(fields: [documentRecordId], references: [id])
  permitType     PermitType?              @relation(fields: [permitTypeId], references: [id])
  permit         Permit?                  @relation(fields: [permitId], references: [id], onDelete: SetNull)
  location       Location?                @relation(fields: [locationId], references: [id])
  notifications  UserNotification[]

  /* Document path keeps its original idempotency key. Permit alerts
     don't conflict with this because their assetId/documentTypeId
     are NULL and Postgres treats NULL as distinct under unique
     constraints. A permit-specific partial index lives in the
     migration to dedupe (companyId, permitId, triggerType, days,
     status) — see migration `add_permits_and_types`. */
  @@unique([companyId, assetId, documentTypeId, triggerType, daysBeforeExpiration, status])
  @@index([companyId, status, triggeredAt])
  @@index([companyId, assetId, status])
  @@index([companyId, severity, status])
  @@index([companyId, permitId, status])
  @@map("alert_instances")
}

/* OPS-018 — singleton-per-company. Houses the global defaults that the
   alert resolver falls back to when no AlertRule overrides apply.
   `enableAutoBlocking` is also consumed by OPS-020. */
model CompanyAlertSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  companyId                   String   @unique @db.Uuid
  defaultDaysBefore           Int      @default(30)
  defaultCriticalDaysBefore   Int      @default(7)
  defaultBlockingDaysBefore   Int      @default(0)
  enableAutoBlocking          Boolean  @default(true)
  enableEmailNotifications    Boolean  @default(false)
  defaultEscalationDays       Int      @default(7)
  /* OPS-033 — global toggle for the auto-commitment listener. When
     false, document/permit renewal-imminent events still fire and
     audit, but the Finance handler short-circuits without creating
     a Commitment row. */
  enableAutoCommitments       Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
  updatedBy                   String   @db.Uuid

  @@map("company_alert_settings")
}

/* OPS-020 — audit trail of every status transition. Distinguishes
   manual edits from system-driven AUTO_BLOCK / AUTO_UNBLOCK. The
   triggering doc-type IDs and alert IDs are kept as flat arrays so a
   single row can describe a multi-document trigger without joining
   another table. */
enum StatusChangeType {
  MANUAL
  AUTO_BLOCK
  AUTO_UNBLOCK
  EXCEPTION_GRANTED
  EXCEPTION_EXPIRED
}

/* OPS-022 — per-user notification inbox. RLS enforces a strict
   companyId AND userId match so notifications stay strictly personal
   even within the same tenant. The source columns let one inbox row
   point back to an alert, an asset block, an escalation, etc. */
enum NotificationSourceType {
  ALERT_INSTANCE
  ASSET_BLOCKED
  ESCALATION
  DOCUMENT_REJECTED
  DOCUMENT_APPROVED
  EXCEPTION_REQUESTED
  EXCEPTION_GRANTED
  WORK_PERMIT_AUTHORIZATION
  WORK_PERMIT_AUTHORIZED
  WORK_PERMIT_REJECTED
  WORK_PERMIT_STARTED
  WORK_PERMIT_CLOSED
  WORK_PERMIT_EXPIRED
  GENERAL
}

model UserNotification {
  id              String                 @id @default(uuid()) @db.Uuid
  companyId       String                 @db.Uuid
  userId          String                 @db.Uuid
  alertInstanceId String?                @db.Uuid
  sourceType      NotificationSourceType
  title           String
  message         String?
  severity        AlertSeverity
  linkPath        String?
  icon            String?
  isRead          Boolean                @default(false)
  readAt          DateTime?
  isDismissed     Boolean                @default(false)
  dismissedAt     DateTime?
  createdAt       DateTime               @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertInstance AlertInstance? @relation(fields: [alertInstanceId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, isRead, createdAt])
  @@index([companyId, userId, isDismissed])
  @@index([alertInstanceId])
  @@map("user_notifications")
}

model AssetStatusChange {
  id                          String           @id @default(uuid()) @db.Uuid
  companyId                   String           @db.Uuid
  assetId                     String           @db.Uuid
  previousStatus              AssetStatus
  newStatus                   AssetStatus
  changeType                  StatusChangeType
  reason                      String?
  changedBy                   String?          @db.Uuid
  triggeringDocumentTypeIds   String[]         @default([]) @db.Uuid
  triggeringAlertInstanceIds  String[]         @default([]) @db.Uuid
  metadata                    Json             @default("{}")
  createdAt                   DateTime         @default(now())

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, assetId, createdAt])
  @@index([companyId, changeType])
  @@map("asset_status_changes")
}

/* OPS-023 — temporary exception that lifts BLOCKED_DOCUMENTAL on an
   asset for a bounded period. The lifecycle is:
   PENDING → APPROVED → (EXPIRED via cron OR REVOKED via admin)
   PENDING → REJECTED. previousStatus snapshots what to revert to so
   the cron can restore the original state cleanly. */
enum ExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model AssetException {
  id                        String          @id @default(uuid()) @db.Uuid
  companyId                 String          @db.Uuid
  assetId                   String          @db.Uuid
  requestedBy               String          @db.Uuid
  requestedReason           String
  requestedAt               DateTime        @default(now())
  requestedDocumentTypeIds  String[]        @default([]) @db.Uuid
  status                    ExceptionStatus @default(PENDING)
  approvedBy                String?         @db.Uuid
  approvedReason            String?
  approvedAt                DateTime?
  rejectedBy                String?         @db.Uuid
  rejectedReason            String?
  rejectedAt                DateTime?
  validFrom                 DateTime?
  validUntil                DateTime?
  previousStatus            AssetStatus?
  /* Internal flag set true once the cron has handled expiration so the
     row isn't re-processed. We still flip status to EXPIRED — this is
     a belt-and-braces guard against re-runs. */
  expiresHandled            Boolean         @default(false)
  revokedBy                 String?         @db.Uuid
  revokedReason             String?
  revokedAt                 DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, status, validUntil])
  @@index([companyId, assetId, status])
  @@map("asset_exceptions")
}

/* OPS-024 — external operational permits. Mirrors DocumentRecord but
   the target can be either an OperationalAsset OR a Location (mining
   site, branch office, etc.), so the same permit rows cover patentes
   municipales (per location) and cosas como Permiso Bomberos (per
   asset). Exactly one of assetId/locationId must be set — enforced by
   a CHECK constraint defined in the migration. */
enum PermitCategory {
  MUNICIPAL
  SANITARY
  ENVIRONMENTAL
  FIRE_DEPT
  LABOR
  ELECTRICAL
  OTHER
}

enum PermitStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACED
  ARCHIVED
}

model PermitType {
  id                      String              @id @default(uuid()) @db.Uuid
  companyId               String              @db.Uuid
  name                    String
  code                    String
  category                PermitCategory
  issuingAuthority        String?
  hasExpiration           Boolean             @default(true)
  defaultValidityDays     Int?
  alertDaysBefore         Int                 @default(30)
  criticalAlertDaysBefore Int                 @default(7)
  criticality             DocumentCriticality
  blocksOperation         Boolean             @default(false)
  description             String?
  icon                    String?
  color                   String?
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  createdBy               String              @db.Uuid

  permits        Permit[]
  alertInstances AlertInstance[]
  approvalSteps  PermitApprovalStep[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, category])
  @@map("permit_types")
}

model Permit {
  id                  String       @id @default(uuid()) @db.Uuid
  companyId           String       @db.Uuid
  permitTypeId        String       @db.Uuid
  /* Exactly one of these two is non-null. The application layer is
     authoritative; the migration adds a CHECK constraint to back this
     up at the DB level. */
  assetId             String?      @db.Uuid
  locationId          String?      @db.Uuid
  permitNumber        String
  issuingAuthority    String?
  issueDate           DateTime?    @db.Date
  expirationDate      DateTime?    @db.Date
  scope               String?
  fileName            String?
  mimeType            String?
  fileSize            Int?
  filePath            String?
  fileData            Bytes?
  status              PermitStatus @default(DRAFT)
  statusReason        String?
  statusChangedAt     DateTime?
  statusChangedBy     String?      @db.Uuid
  uploadedBy          String       @db.Uuid
  approvedBy          String?      @db.Uuid
  approvedAt          DateTime?
  rejectedBy          String?      @db.Uuid
  rejectedAt          DateTime?
  version             Int          @default(1)
  replacedByPermitId  String?      @db.Uuid
  notes               String?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  /* OPS-026 — multi-step approval workflow. Backwards-compatible
     defaults (`currentApprovalStep=0`, `totalApprovalSteps=1`,
     `isFullyApproved=false`) preserve OPS-024's single-step
     approve/reject for existing rows. */
  currentApprovalStep Int     @default(0)
  totalApprovalSteps  Int     @default(1)
  isFullyApproved     Boolean @default(false)

  permitType     PermitType        @relation(fields: [permitTypeId], references: [id])
  asset          OperationalAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  replacedBy     Permit?           @relation("PermitSupersession", fields: [replacedByPermitId], references: [id])
  replaces       Permit[]          @relation("PermitSupersession")
  alertInstances AlertInstance[]
  approvals      PermitApproval[]

  @@index([companyId, assetId])
  @@index([companyId, locationId])
  @@index([companyId, permitTypeId])
  @@index([companyId, status])
  @@index([companyId, expirationDate])
  @@map("permits")
}

/* OPS-025 — Internal work permits (Permisos de Trabajo). Unlike the
   external Permit model above (regulatory papers, renewed yearly),
   work permits are short-lived safety instruments emitted for ONE
   specific high-risk task and CLOSED when the task ends. */
enum WorkPermitCategory {
  HEIGHT_WORK
  HOT_WORK
  CONFINED_SPACE
  LOCKOUT_TAGOUT
  EXCAVATION
  LIFTING
  ELECTRICAL_WORK
  CHEMICAL_HANDLING
  OTHER
}

enum WorkPermitStatus {
  DRAFT
  PENDING_AUTHORIZATION
  AUTHORIZED
  IN_EXECUTION
  SUSPENDED
  CLOSED
  CANCELLED
  EXPIRED
}

model WorkPermitType {
  id                       String             @id @default(uuid()) @db.Uuid
  companyId                String             @db.Uuid
  name                     String
  code                     String
  category                 WorkPermitCategory
  description              String?
  maxDurationHours         Int                @default(8)
  /* Roles required to authorize this permit (subset of UserRole values
     stored as strings — no FK to enum since Prisma can't constrain
     array elements). */
  requiredRoles            String[]           @default([])
  requiresMedicalAptitude  Boolean            @default(false)
  requiresSpecificTraining Boolean            @default(false)
  requiresGasMeasurement   Boolean            @default(false)
  requiresIsolation        Boolean            @default(false)
  defaultRisks             String[]           @default([])
  defaultControls          String[]           @default([])
  icon                     String?
  color                    String?
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  createdBy                String             @db.Uuid

  permits       WorkPermit[]
  approvalSteps PermitApprovalStep[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, category])
  @@map("work_permit_types")
}

model WorkPermit {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @db.Uuid
  permitTypeId        String           @db.Uuid
  /* Auto-generated per-company sequence "PT-{YEAR}-{0000}". */
  permitNumber        String
  title               String
  description         String
  workLocation        String?
  assetId             String?          @db.Uuid
  locationId          String?          @db.Uuid

  plannedStart        DateTime
  plannedEnd          DateTime
  actualStart         DateTime?
  actualEnd           DateTime?

  requestedBy         String           @db.Uuid
  supervisorId        String           @db.Uuid
  /* Array of { userId?, name, role, signature? } — supports external
     workers without an internal user account. */
  workTeam            Json             @default("[]")

  identifiedRisks     String[]         @default([])
  controlMeasures     String[]         @default([])
  additionalNotes     String?

  authorizedBy        String?          @db.Uuid
  authorizedAt        DateTime?
  authorizationNotes  String?

  closedBy            String?          @db.Uuid
  closedAt            DateTime?
  closureNotes        String?
  incidentsReported   Boolean          @default(false)
  incidentDescription String?

  status              WorkPermitStatus @default(DRAFT)
  statusReason        String?
  statusChangedAt     DateTime?
  statusChangedBy     String?          @db.Uuid

  /* Category-specific structured payloads. gasMeasurements is an
     append-only log of readings; isolationPoints is the live LOTO
     state of the lock-and-tag operation. */
  gasMeasurements     Json?
  isolationPoints     Json?

  /* Inline attachments, max 5 entries. Each entry mirrors the
     storage convention used by Documents/Permits — fileData is the
     DB blob fallback when MinIO is not configured. */
  attachments         Json             @default("[]")

  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  /* OPS-026 — multi-step approval workflow. */
  currentApprovalStep Int     @default(0)
  totalApprovalSteps  Int     @default(1)
  isFullyApproved     Boolean @default(false)

  permitType WorkPermitType    @relation(fields: [permitTypeId], references: [id])
  asset      OperationalAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  location   Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  approvals  PermitApproval[]

  @@unique([companyId, permitNumber])
  @@index([companyId, status, plannedStart])
  @@index([companyId, supervisorId])
  @@index([companyId, assetId])
  @@index([companyId, permitNumber])
  @@map("work_permits")
}

/* OPS-026 — multi-step authorization workflow shared between
   external permits (OPS-024) and internal work permits (OPS-025).
   PermitApprovalStep is the *template* (per permit type), and
   PermitApproval is the *instance* (per permit row). The exact-one
   target columns are guarded by DB CHECK constraints in the
   migration so the application layer can't accidentally create
   ambiguous rows. */
enum ApprovalActionStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model PermitApprovalStep {
  id                                String   @id @default(uuid()) @db.Uuid
  companyId                         String   @db.Uuid
  /* Exactly one of these two is non-null — DB CHECK enforces. */
  workPermitTypeId                  String?  @db.Uuid
  permitTypeId                      String?  @db.Uuid

  stepOrder                         Int
  name                              String
  description                       String?

  /* Roles allowed to approve this step. Stored as TEXT[] (UserRole
     enum values as strings) so the schema stays company-portable
     without per-tenant enum migrations. */
  requiredRoles                     String[] @default([])
  requiresSpecificUserId            String?  @db.Uuid
  mustBeDifferentFromRequester      Boolean  @default(true)
  mustBeDifferentFromPreviousApprovers Boolean @default(true)

  isOptional                        Boolean  @default(false)
  skipConditionsJson                Json?

  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
  createdBy                         String?  @db.Uuid

  workPermitType WorkPermitType?  @relation(fields: [workPermitTypeId], references: [id], onDelete: Cascade)
  permitType     PermitType?      @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  approvals      PermitApproval[]

  @@index([companyId, workPermitTypeId, stepOrder])
  @@index([companyId, permitTypeId, stepOrder])
  @@map("permit_approval_steps")
}

/* OPS-027 — Procedures library. Internal company-published
   instructional content (operational, safety, maintenance,
   emergency). Distinct from external Documents (Sprint 4) and
   Permits (OPS-024/025): procedures don't expire, they are
   versioned and superseded; they may require user acknowledgment
   (OPS-028 wires that). */
enum ProcedureCategory {
  OPERATION
  MAINTENANCE
  EMERGENCY
  SAFETY
  QUALITY
  ENVIRONMENTAL
  OTHER
}

enum ProcedureStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  DEPRECATED
}

enum RevisionType {
  CREATED
  UPDATED
  REVIEWED
  PUBLISHED
  SUPERSEDED
  DEPRECATED
  RESTORED
}

model Procedure {
  id                          String            @id @default(uuid()) @db.Uuid
  companyId                   String            @db.Uuid
  code                        String
  title                       String
  description                 String?
  category                    ProcedureCategory

  authoredBy                  String            @db.Uuid
  reviewedBy                  String?           @db.Uuid
  reviewedAt                  DateTime?
  publishedBy                 String?           @db.Uuid
  publishedAt                 DateTime?
  deprecatedBy                String?           @db.Uuid
  deprecatedAt                DateTime?

  /* Semantic version string (free-form so users can use 1.0,
     2024-01, A.0, etc). The (companyId, code, version) unique
     index enforces no two rows of the same procedure share a
     version. */
  version                     String
  changelog                   String?
  replacesProcedureId         String?           @db.Uuid
  replacedByProcedureId       String?           @db.Uuid

  fileName                    String
  mimeType                    String
  fileSize                    Int
  filePath                    String?
  fileData                    Bytes?

  /* Up to 10 attachment entries; each carries either a MinIO
     filePath or a base64 fileData fallback. */
  attachments                 Json              @default("[]")

  keywords                    String[]          @default([])
  scope                       String?
  estimatedReadingMinutes     Int?
  requiresAcknowledgment      Boolean           @default(false)
  acknowledgmentDeadlineDays  Int?

  applicableAssetTypeIds      String[]          @default([]) @db.Uuid
  applicableAssetIds          String[]          @default([]) @db.Uuid
  applicableLocationIds       String[]          @default([]) @db.Uuid
  applicableRoles             String[]          @default([])

  status                      ProcedureStatus   @default(DRAFT)
  statusReason                String?

  isActive                    Boolean           @default(true)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  replaces        Procedure?                @relation("ProcedureSupersession", fields: [replacesProcedureId], references: [id], onDelete: SetNull)
  replacedBy      Procedure[]               @relation("ProcedureSupersession")
  revisions       ProcedureRevision[]
  acknowledgments ProcedureAcknowledgment[]

  @@unique([companyId, code, version])
  @@index([companyId, status, category])
  @@index([companyId, code])
  @@map("procedures")
}

model ProcedureRevision {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  procedureId   String       @db.Uuid
  revisionType  RevisionType
  changedBy     String       @db.Uuid
  changeNotes   String?
  /* Snapshot of the changed fields. JSONB so we don't have to
     enumerate every column up front. */
  previousData  Json?
  newData       Json?
  createdAt     DateTime     @default(now())

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([companyId, procedureId, createdAt])
  @@map("procedure_revisions")
}

/* OPS-028 — required readings per user. Created automatically when
   a procedure with requiresAcknowledgment=true is published. The
   user is the subject of record (signature hash binds the ack to
   them) and the procedure is what they're acknowledging. */
enum AcknowledgmentStatus {
  PENDING
  READ
  ACKNOWLEDGED
  EXPIRED
  EXEMPTED
}

model ProcedureAcknowledgment {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  procedureId            String               @db.Uuid
  userId                 String               @db.Uuid

  status                 AcknowledgmentStatus @default(PENDING)

  /* Reading evidence — incremented each time the user opens the
     procedure file. The first view also flips the row from PENDING
     to READ. */
  firstViewedAt          DateTime?
  viewCount              Int                  @default(0)
  acknowledgedAt         DateTime?
  /* SHA-256 of (procedureId + userId + ISO timestamp + notes). */
  signatureHash          String?
  acknowledgedFromIp     String?
  acknowledgedUserAgent  String?
  acknowledgmentNotes    String?

  /* Lifecycle dates — dueDate is computed from the procedure's
     acknowledgmentDeadlineDays at create time. */
  createdAt              DateTime             @default(now())
  dueDate                DateTime?
  reminderCount          Int                  @default(0)
  lastReminderSentAt     DateTime?

  exemptedBy             String?              @db.Uuid
  exemptedAt             DateTime?
  exemptionReason        String?

  updatedAt              DateTime             @updatedAt

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([companyId, procedureId, userId])
  @@index([companyId, userId, status])
  @@index([companyId, procedureId, status])
  @@index([companyId, status, dueDate])
  @@map("procedure_acknowledgments")
}

model PermitApproval {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  /* Exactly one of these two is non-null — DB CHECK enforces. */
  workPermitId    String?              @db.Uuid
  permitId        String?              @db.Uuid

  approvalStepId  String               @db.Uuid
  stepOrder       Int
  stepName        String

  approvedBy      String?              @db.Uuid
  approvedAt      DateTime?
  rejectedBy      String?              @db.Uuid
  rejectedAt      DateTime?
  notes           String?

  /* SHA-256 of (permitId + userId + ISO timestamp + notes). Captured
     once at the approval action and never recomputed; alongside the
     audit trigger this gives us non-repudiation. */
  signatureHash   String?
  userIp          String?
  userAgent       String?

  status          ApprovalActionStatus @default(PENDING)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workPermit     WorkPermit?         @relation(fields: [workPermitId], references: [id], onDelete: Cascade)
  permit         Permit?             @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approvalStep   PermitApprovalStep  @relation(fields: [approvalStepId], references: [id], onDelete: Restrict)

  @@index([companyId, workPermitId, stepOrder])
  @@index([companyId, permitId, stepOrder])
  @@index([companyId, status, createdAt])
  @@map("permit_approvals")
}


/* OPS-032 — domain events. Internal pub/sub trail emitted by the
   Operations module so Finance (and any future module) can react
   without a tight coupling. Persisted before broadcast so handlers
   can replay on retry, and so admins have an audit trail of what
   was emitted, what was processed, and what failed. */

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model DomainEvent {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid

  /* Dotted event name — e.g. "document.renewal-imminent". Matches
     the EventEmitter wildcard string used by NestJS @OnEvent
     handlers. */
  eventType       String

  /* Domain aggregate the event is about — e.g. ("DocumentRecord",
     <id>). Lets the audit table answer "show me everything that
     happened to this asset" without parsing payloads. */
  aggregateType   String
  aggregateId     String            @db.Uuid

  /* Full event payload. The shape is defined per eventType in
     domain-event-types.ts; the column is loose JSON so the schema
     doesn't fight a typed event surface that evolves. */
  payload         Json

  occurredAt      DateTime          @default(now())
  handledAt       DateTime?
  status          DomainEventStatus @default(PENDING)

  /* Per-handler outcomes — populated when the bus fans out to
     multiple listeners. `null` until handlers run. */
  handlerResults  Json?
  failureReason   String?
  retryCount      Int               @default(0)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  /* Idempotency — emitting "the same event for the same aggregate at
     the same instant" is a duplicate. The combination is wide enough
     that legitimate re-emissions a millisecond apart still get
     through, but tight enough that the alert engine running
     repeatedly on the same minute won't double-emit. */
  @@unique([companyId, eventType, aggregateId, occurredAt])
  @@index([companyId, eventType, occurredAt])
  @@index([companyId, status])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
}

/* OPS-036 — packaged compliance evidence. One row per generated
   audit package: persists the manifest JSON (with per-file SHA-256
   hashes), the file blob (or MinIO key when storage is configured),
   and the master signature so re-downloads can prove the bytes are
   the originals. Distinct from `audit_logs` (PG-trigger row history)
   which is a separate audit surface. */
model AuditPackage {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  generatedAt      DateTime  @default(now())
  generatedBy      String    @db.Uuid

  /* Free-form scope captured at generation. Includes period, location
     and asset-type filters, and the auditor-supplied reason — all
     written into the manifest the auditor downloads. */
  scope            Json
  manifest         Json
  packageSignature String

  filePath         String?
  fileData         Bytes?
  fileSize         Int

  reason           String
  expiresAt        DateTime?

  createdAt        DateTime  @default(now())

  @@index([companyId, generatedAt])
  @@index([generatedBy])
  @@map("audit_packages")
}

