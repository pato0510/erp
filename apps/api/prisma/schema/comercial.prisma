/* COM-002 — Comercial (CRM) schema. First Comercial table: service_catalog, the
   shared list of services AGS offers. Comercial OWNS it (write = MANAGER/ADMIN/
   SUPER_ADMIN); every role READS it (non-sensitive). opportunity_services and
   quote_lines will FK to it in later tickets. Generic V1 shape — richer fields
   deferred to a V2 pass. Enums use ASCII-only members (Prisma enum Ñ gotcha);
   display labels live in the UI layer. The platform invariant (RLS + audit
   trigger + app_user GRANT) is in migration 20260702120000_add_service_catalog. */

enum ServiceCategory {
  GENERAL
  ASEO
  TRANSPORTE
  MANTENIMIENTO
  OTRO
}

enum ServiceUnit {
  UNIDAD
  MENSUAL
  POR_PERSONA
  POR_FAENA
  POR_EVENTO
}

model ServiceCatalog {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  name        String
  description String?
  code        String? // optional internal SKU
  category    ServiceCategory
  unit        ServiceUnit
  basePrice   Decimal         @db.Decimal(18, 2) // CLP — same money type as compensation/commitment amounts
  isActive    Boolean         @default(true)
  createdBy   String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  opportunityServices OpportunityService[] // COM-006 — bundle lines referencing this service (FK ON DELETE RESTRICT)

  @@index([companyId])
  @@map("service_catalog")
}

/* COM-003 — account lifecycle status. New business enters as PROSPECTO; when
   confirmed it becomes ACTIVA; INACTIVA is the soft-deactivated state. Transitions
   are FREE (no state machine). ASCII members; display labels in the UI. */
enum AccountStatus {
  PROSPECTO
  ACTIVA
  INACTIVA
}

enum AccountPriority {
  ALTA
  MEDIA
  BAJA
}

/* COM-003 — accounts: the CRM's core entity (AGS's commercial portfolio). New
   business enters directly as an account with status PROSPECTO (there is NO
   separate leads table — deliberate). Fiscal identity (RUT, tax history) lives in
   Finance `counterparties`; an account only OPTIONALLY references it and stays
   DECOUPLED — creating an account never auto-creates a counterparty; linkage is
   manual. `ownerId` (commercial executive) and `createdBy` are bare actor UUIDs
   (codebase convention, no FK). `sourceCampaignId` is a prepared hook for the
   future Marketing module — NO FK (the campaigns table does not exist yet). Only
   `counterpartyId` is a real FK (ON DELETE SET NULL — deleting a counterparty
   only unlinks, never deletes/blocks the account). The platform invariant (RLS +
   audit trigger + app_user GRANT) is in migration 20260702130000_add_accounts. */
model Account {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @db.Uuid
  name             String
  status           AccountStatus   @default(PROSPECTO)
  industry         String?
  priority         AccountPriority @default(MEDIA)
  commercialRisk   String? // free-text note for V1 (not an enum)
  ownerId          String?         @db.Uuid // commercial executive — bare actor UUID (no FK), like createdBy
  counterpartyId   String?         @db.Uuid // optional link to Finance counterparties
  sourceCampaignId String?         @db.Uuid // Marketing hook — NO FK (campaigns table not created yet)
  notes            String?
  createdBy        String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  counterparty  Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  contacts      Contact[] // COM-004 — people within this account (FK on contacts.accountId, ON DELETE CASCADE)
  opportunities Opportunity[] // COM-005 — deals on this account (FK on opportunities.accountId, ON DELETE RESTRICT)
  activities    Activity[] // COM-008 — the account's interaction history (FK ON DELETE CASCADE)

  @@index([companyId])
  @@map("accounts")
}

/* COM-004 — contacts: people within a commercial account (e.g. the client's ops
   chief, procurement lead). A contact is a DEPENDENT CHILD of an account — the FK
   is ON DELETE CASCADE (deleting an account removes its contacts), deliberately
   unlike the account↔counterparty SET NULL peer reference. Contacts share the
   account permission profile (same CASL grants). At most one contact per account
   may have isPrimary=true — enforced in the SERVICE layer (not a DB constraint).
   Platform invariant (RLS + audit + GRANT) is in migration 20260702140000_add_contacts. */
model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  accountId String   @db.Uuid
  firstName String
  lastName  String
  role      String? // job title at the client (free text)
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([accountId])
  @@map("contacts")
}

/* COM-005 — opportunity stages (the pipeline). Active flow: PROSPECTO → CONTACTO →
   VISITA_TECNICA → COTIZACION → NEGOCIACION (free movement). GANADA / PERDIDA are
   semi-terminal (only a dedicated reopen exits them). EN_PAUSA parks an active
   deal (previousStage remembers where it was). ASCII members; display labels in UI. */
enum OpportunityStage {
  PROSPECTO
  CONTACTO
  VISITA_TECNICA
  COTIZACION
  NEGOCIACION
  GANADA
  PERDIDA
  EN_PAUSA
}

enum LostReason {
  PRECIO
  COMPETENCIA
  PROYECTO_CANCELADO
  OTRO
}

/* COM-005 — opportunities: the pipeline's core entity (a deal AGS pursues with an
   account). REQUIRED FK to accounts with ON DELETE RESTRICT — an account with
   opportunities cannot be hard-deleted (its own soft-deactivate lifecycle is
   unaffected). Stage transitions are enforced in the SERVICE (not the DB); GANADA/
   PERDIDA are semi-terminal (reopen-only). ownerId/createdBy are bare actor UUIDs
   (no FK). estimatedValue is CLP money (same Decimal(18,2) as service_catalog /
   compensation). expectedCloseDate is @db.Date, stored UTC-anchored to avoid the
   date off-by-one. Platform invariant (RLS + audit + GRANT) is in migration
   20260702150000_add_opportunities. */
model Opportunity {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  accountId         String            @db.Uuid
  name              String
  stage             OpportunityStage  @default(PROSPECTO)
  previousStage     OpportunityStage? // where it was before EN_PAUSA (for resume)
  estimatedValue    Decimal?          @db.Decimal(18, 2) // CLP
  probability       Int? // 0–100
  expectedCloseDate DateTime?         @db.Date
  ownerId           String?           @db.Uuid // commercial executive — bare actor UUID (no FK)
  lostReason        LostReason?
  lostReasonDetail  String?
  closedAt          DateTime? // set when moved to GANADA/PERDIDA
  notes             String?
  createdBy         String            @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  account    Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  services   OpportunityService[] // COM-006 — the service bundle (FK on opportunity_services.opportunityId, ON DELETE CASCADE)
  activities Activity[] // COM-008 — timeline entries linked to this deal (FK ON DELETE SET NULL)

  @@index([companyId])
  @@index([accountId])
  @@index([stage])
  @@map("opportunities")
}

/* COM-006 — opportunity_services: the service bundle of an opportunity (which
   catalog services a deal packages, at what quantity and price). A line is a
   DEPENDENT CHILD of an opportunity — the FK is ON DELETE CASCADE (deleting the
   deal removes its bundle, like contacts). It references a service_catalog entry
   with ON DELETE RESTRICT: a catalog service used by any line CANNOT be hard-
   deleted; deactivation (isActive=false) is the normal path and never touches
   existing lines. PRICE SNAPSHOT: unitPrice is COPIED from the catalog basePrice
   when the line is added and is thereafter editable per deal — later catalog price
   changes never alter existing lines. DERIVED TOTAL: while an opportunity has ≥1
   line, its estimatedValue is Σ(quantity × unitPrice), recomputed in the service
   on every add/edit/remove; manual estimatedValue edits are rejected until the
   bundle is emptied. quantity is fractional (e.g. 2.5 months). At most one line per
   (opportunity, service) — @@unique. Platform invariant (RLS + audit + GRANT) is in
   migration 20260703120000_add_opportunity_services. */
model OpportunityService {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  opportunityId String   @db.Uuid
  serviceId     String   @db.Uuid
  quantity      Decimal  @db.Decimal(18, 4) // fractional quantities are real (e.g. 2.5 months); > 0 enforced in the service
  unitPrice     Decimal  @db.Decimal(18, 2) // CLP — snapshotted from service_catalog.basePrice on add, editable afterwards
  notes         String?
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  service     ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, serviceId])
  @@index([companyId])
  @@index([opportunityId])
  @@index([serviceId])
  @@map("opportunity_services")
}

/* COM-008 — activity types (the CRM interaction log). ASCII members; display labels
   live in the UI (VISITA_FAENA → "Visita a faena"). */
enum ActivityType {
  LLAMADA
  REUNION
  EMAIL
  VISITA_FAENA
  NOTA
}

/* COM-008 — activities: the CRM interaction timeline (calls, meetings, emails, faena
   visits, notes). An activity ALWAYS belongs to an account (FK ON DELETE CASCADE —
   activities ARE the account's history) and OPTIONALLY references one of that
   account's opportunities (FK ON DELETE SET NULL — deleting an open opportunity must
   NOT erase the account's real history, only unlink it). `activityDate` is WHEN the
   interaction happened (distinct from createdAt, when it was logged). This ticket
   creates MANUAL activities only; `isSystemGenerated` is the prepared flag for the
   COM-009 system-generated entries (stage changes etc.) — the API forces it false on
   every create here and the service refuses to update/delete a row where it is true.
   Platform invariant (RLS + audit + GRANT) is in migration 20260706120000_add_activities. */
model Activity {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @db.Uuid
  accountId         String       @db.Uuid
  opportunityId     String?      @db.Uuid
  type              ActivityType
  subject           String
  detail            String?
  activityDate      DateTime     @default(now()) // WHEN it happened (distinct from createdAt)
  isSystemGenerated Boolean      @default(false) // COM-009 hook; forced false on manual create
  createdBy         String       @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([accountId])
  @@index([opportunityId])
  @@index([activityDate])
  @@map("activities")
}
