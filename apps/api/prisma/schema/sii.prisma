// SII (Servicio de Impuestos Internos) connection per company.
//
// `certificatePath`  — MinIO key of the encrypted .pfx under SII_CERT_BUCKET.
// `certificatePasswordHash` — despite the "hash" suffix in the field name,
//   this column holds the AES-256-GCM ciphertext of the cert password,
//   base64-encoded with the IV and auth tag embedded. We cannot use a
//   one-way hash because the password must be replayed to LibreDTE.
//   Never log, expose, or return this value to the frontend.
model SiiConnection {
  id                      String    @id @default(uuid()) @db.Uuid
  companyId               String    @unique @db.Uuid
  rut                     String
  certificatePath         String?
  certificatePasswordHash String?
  isActive                Boolean   @default(false)
  lastSyncAt              DateTime?
  lastErrorMessage        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("sii_connections")
}
