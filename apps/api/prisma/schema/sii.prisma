// SII (Servicio de Impuestos Internos) connection per company.
//
// Certificate storage is dual-mode: MinIO/S3 when configured, otherwise the
// .pfx bytes live directly in the DB so deployments without object storage
// (e.g. Railway without an attached bucket) still work.
//
// `certificatePath` — MinIO key under SII_CERT_BUCKET (preferred).
// `certificateData` — raw .pfx bytes (fallback when MinIO is unavailable).
// `certificateName` — original filename, only meaningful for the DB path.
// `certificatePasswordHash` — despite the "hash" suffix in the field name,
//   this column holds the AES-256-GCM ciphertext of the cert password,
//   base64-encoded with the IV and auth tag embedded. We cannot use a
//   one-way hash because the password must be replayed to LibreDTE.
//   Never log, expose, or return this value to the frontend.
model SiiConnection {
  id                      String    @id @default(uuid()) @db.Uuid
  companyId               String    @unique @db.Uuid
  rut                     String
  certificatePath         String?
  certificateData         Bytes?
  certificateName         String?
  certificatePasswordHash String?
  isActive                Boolean   @default(false)
  lastSyncAt              DateTime?
  lastErrorMessage        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("sii_connections")
}
