// ─────────────────────────────────────────────────────────────────────────
// MÓDULO RRHH (V1) — schema
//
// HR-002: job_positions (cargos / perfiles de cargo) — the first RRHH table.
// Every RRHH table follows the platform invariant: RLS policy + audit trigger +
// GRANT to app_user, applied IN the migration (see the add_job_positions
// migration) so production gets it on deploy. Scoped by companyId at the
// application layer; writes go through RlsService.executeWithRls.
//
// AreaRRHH members are ASCII (no Ñ) — the UI maps them to display labels
// (e.g. PREVENCION_RIESGOS → "Prevención de Riesgos").
// ─────────────────────────────────────────────────────────────────────────

enum AreaRRHH {
  OPERACIONES
  ADMINISTRACION
  COMERCIAL
  GERENCIA
  FINANZAS
  PREVENCION_RIESGOS
  MANTENIMIENTO
  RRHH
}

model JobPosition {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  name              String
  area              AreaRRHH
  description       String?
  // Free String[] for now — validated against the cert enum / service catalog /
  // document-type catalog once those RRHH modules exist (HR-003+).
  requiredCertTypes String[] @default([])
  requiredDocTypes  String[] @default([])
  enabledServices   String[] @default([])
  active            Boolean  @default(true)
  createdBy         String   @db.Uuid
  updatedBy         String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employees                    Employee[]
  employeeDocumentRequirements EmployeeDocumentRequirement[]

  @@index([companyId])
  @@map("job_positions")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-003 — employees (the central ficha) + employee_compensation (the guarded
// 1:1 sub-resource). Salary/bank fields live ONLY in employee_compensation,
// which is reachable solely via the dedicated, role-restricted endpoint — the
// employee list/ficha payloads NEVER carry compensation. ASCII enums; the UI
// maps display labels.
// ─────────────────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVO
  INACTIVO
  DESVINCULADO
}

enum ContractType {
  INDEFINIDO
  PLAZO_FIJO
  POR_OBRA
  HONORARIOS
  EXTERNO
}

enum HealthSystem {
  FONASA
  ISAPRE
}

model Employee {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  // Nullable link to a login user — field staff exist as fichas with NO user.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName         String
  rut              String // validated Módulo-11 (@erp/utils validateRut) at the service layer
  birthDate        DateTime? @db.Date
  nationality      String?
  personalEmail    String?
  companyEmail     String?
  phone            String?
  address          String?
  emergencyContact String?
  emergencyPhone   String?

  jobPositionId String?      @db.Uuid
  jobPosition   JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  area AreaRRHH

  supervisorId String?    @db.Uuid
  supervisor   Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeSupervisor")

  base         String?
  hireDate     DateTime       @db.Date
  status       EmployeeStatus @default(ACTIVO)
  contractType ContractType? // convenience summary; authoritative contracts arrive in HR-007
  notes        String?

  // HR-011 — manual feriado progresivo (días adicionales). Set by the HR admin;
  // V1 has NO automatic progresivo calc (prior-employer proof + 10-year cap = V2).
  diasAdicionalesFeriado Int @default(0)

  compensation EmployeeCompensation?

  employeeDocuments            EmployeeDocument[]
  employeeDocumentRequirements EmployeeDocumentRequirement[]

  employeeContracts   EmployeeContract[] @relation("EmployeeContracts")
  supervisedContracts EmployeeContract[] @relation("ContractSupervisor")

  vacationRequests VacationRequest[]
  absences         Absence[]

  payrollSettlements PayrollSettlement[]
  terminationRecords TerminationRecord[]

  createdBy String   @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, rut])
  @@index([companyId])
  @@map("employees")
}

model EmployeeCompensation {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  employeeId String   @unique @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  baseSalaryGross Decimal       @db.Decimal(18, 2)
  afp             String?
  health          HealthSystem?
  bank            String?
  bankAccountType String?
  bankAccount     String?

  createdBy String   @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("employee_compensation")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-004a — employee documents. Three thin tables COPY-ADAPTED from the
// Operations document-control engine (recon R1: the live engine is too
// asset-bound to reuse — non-null assetId FK + asset-blocking coupling — so
// RRHH gets its own tables and copies the proven algorithms, assetId→employeeId,
// dropping the asset-blocking/commitment side effects). REUSED verbatim:
// StorageService (MinIO + DB-blob fallback) and the DocumentRecordStatus enum.
// Every table ships the platform invariant in the migration: RLS policy + audit
// trigger + GRANT to app_user. Writes go through RlsService.executeWithRls.
// ASCII enums; the UI maps display labels.
// ─────────────────────────────────────────────────────────────────────────

enum EmployeeDocCategory {
  CONTRATO
  IDENTIDAD
  PREVISIONAL
  SALUD
  SEGURIDAD
  CERTIFICACION
  AMONESTACION
  FINIQUITO
  OTRO
}

// RRHH's own approval-status enum. Operations folds approval into
// DocumentRecordStatus (APPROVED/REJECTED); HR-004a additionally tracks an
// explicit approvalStatus per the data-model spec. The two are kept in sync by
// the service (APPROVED↔APROBADO, REJECTED↔RECHAZADO).
enum EmployeeDocApprovalStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// RRHH's own document-type catalog — separate from OperationalDocumentType
// (recon R1 open-question: avoid HR/asset doc-type bleed). Seeded with the
// Chilean HR set via POST /api/rrhh/document-types/seed-recommended.
model EmployeeDocumentType {
  id                  String              @id @default(uuid()) @db.Uuid
  companyId           String              @db.Uuid
  name                String
  category            EmployeeDocCategory
  defaultValidityDays Int?
  requiresExpiry      Boolean             @default(false)
  isMandatoryDefault  Boolean             @default(false)
  active              Boolean             @default(true)
  createdBy           String              @db.Uuid
  updatedBy           String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  requirements EmployeeDocumentRequirement[]
  documents    EmployeeDocument[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("employee_document_types")
}

// Two-level requirements matrix (employee > jobPosition), copy-adapted from the
// asset>subtype>type engine. Exactly one of employeeId / jobPositionId is set —
// enforced by a DB CHECK in the migration and validated at the service layer.
model EmployeeDocumentRequirement {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  employeeId      String?  @db.Uuid
  jobPositionId   String?  @db.Uuid
  documentTypeId  String   @db.Uuid
  isMandatory     Boolean  @default(true)
  appliesToClient String? // habilitación por cliente
  appliesToSite   String? // habilitación por faena
  createdBy       String   @db.Uuid
  updatedBy       String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee     Employee?            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobPosition  JobPosition?         @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  documentType EmployeeDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("employee_document_requirements")
}

// The records — copy-adapted from DocumentRecord (assetId→employeeId). storageKey
// is nullable so the DB-blob fallback (blobFallback) works exactly like the
// Operations filePath?/fileData? pair: exactly one is populated per row.
// Immutable supersession via supersededById; uploader≠approver enforced in the
// service; compliance excludes REPLACED.
model EmployeeDocument {
  id              String                    @id @default(uuid()) @db.Uuid
  companyId       String                    @db.Uuid
  employeeId      String                    @db.Uuid
  documentTypeId  String                    @db.Uuid
  fileName        String
  storageKey      String? // MinIO key (StorageService); null when DB-blob fallback used
  blobFallback    Bytes? // populated only when MinIO is unavailable
  mimeType        String
  sizeBytes       Int
  issueDate       DateTime?                 @db.Date
  expiryDate      DateTime?                 @db.Date // auto from defaultValidityDays when requiresExpiry
  status          DocumentRecordStatus      @default(DRAFT)
  statusReason    String?
  version         Int                       @default(1)
  supersededById  String?                   @db.Uuid
  approvalStatus  EmployeeDocApprovalStatus @default(PENDIENTE)
  approvedBy      String?                   @db.Uuid
  approvedAt      DateTime?
  rejectedBy      String?                   @db.Uuid
  rejectedAt      DateTime?
  rejectionReason String?
  uploadedBy      String                    @db.Uuid
  createdBy       String                    @db.Uuid
  updatedBy       String?                   @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType EmployeeDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  supersededBy EmployeeDocument?    @relation("EmployeeDocSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   EmployeeDocument[]   @relation("EmployeeDocSupersession")

  // HR-007 — optional link from a contract to its signed PDF (not fused).
  contracts EmployeeContract[]
  // HR-012 — optional link from an absence (permiso/licencia) to its certificate.
  absences Absence[]
  // HR-009 — optional link from a settlement to its UPLOADED signed PDF.
  payrollSettlements PayrollSettlement[]

  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("employee_documents")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-007 — employee contracts + anexos. Structured contract data (the signed
// PDF stays an EmployeeDocument, optionally linked via documentId — NOT fused).
// Anexos attach to a principal via parentContractId (self-FK). Exactly one
// principal (parentContractId NULL) VIGENTE contract per employee — enforced
// atomically in the service (prior principal → REEMPLAZADO). Reuses the existing
// ContractType enum (HR-003). RLS + audit + GRANT shipped in the migration.
// ASCII enums; the UI maps display labels.
// ─────────────────────────────────────────────────────────────────────────

enum ContractWorkSchedule {
  COMPLETA
  PARCIAL
  TURNO
  ESPECIAL
}

enum GratificationType {
  NO
  LEGAL
  PACTADA
}

enum ContractStatus {
  VIGENTE
  VENCIDO
  REEMPLAZADO
  TERMINADO
}

model EmployeeContract {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  employeeId          String               @db.Uuid
  contractType        ContractType
  startDate           DateTime             @db.Date
  endDate             DateTime?            @db.Date // required when PLAZO_FIJO/POR_OBRA (service-enforced)
  contractualRole     String? // the role/cargo as written in the contract
  workSchedule        ContractWorkSchedule
  baseSalary          Decimal              @db.Decimal(18, 2)
  gratification       GratificationType    @default(NO)
  gratificationAmount Decimal?             @db.Decimal(18, 2)
  mealAllowance       Decimal?             @db.Decimal(18, 2)
  transportAllowance  Decimal?             @db.Decimal(18, 2)
  workLocation        String? // free text / base for now
  mainDuties          String?
  supervisorId        String?              @db.Uuid // supervisor named in the contract
  documentId          String?              @db.Uuid // optional link to the signed PDF (EmployeeDocument)
  parentContractId    String?              @db.Uuid // set → this row is an anexo of the referenced principal
  status              ContractStatus       @default(VIGENTE)
  notes               String?
  createdBy           String               @db.Uuid
  updatedBy           String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  employee   Employee           @relation("EmployeeContracts", fields: [employeeId], references: [id], onDelete: Cascade)
  supervisor Employee?          @relation("ContractSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  document   EmployeeDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  parent     EmployeeContract?  @relation("ContractAnexos", fields: [parentContractId], references: [id], onDelete: SetNull)
  anexos     EmployeeContract[] @relation("ContractAnexos")

  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("employee_contracts")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-011 — vacaciones / feriado legal (Chile, owner-validated calc). The saldo
// (balance) is COMPUTED, never stored: devengado (1.25 días hábiles/mes from
// hireDate, +1.25/30 per partial-month day) + díasAdicionales − días hábiles of
// APROBADO/TOMADO requests. Annual entitlement is a PARAMETER
// (CompanySettings.feriadoAnualDiasHabiles, default 15). "Días hábiles" = Mon–Fri
// only; Chilean festivos are NOT handled in V1 — admin may override diasHabiles
// per request. RLS + audit + GRANT shipped in the migration. ASCII enum.
// ─────────────────────────────────────────────────────────────────────────

enum VacationRequestStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  TOMADO
  CANCELADO
}

model VacationRequest {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  employeeId      String                @db.Uuid
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  diasHabiles     Int // Mon–Fri count between start/end inclusive; admin-overridable for festivos
  status          VacationRequestStatus @default(PENDIENTE)
  requestedBy     String?               @db.Uuid
  approvedBy      String?               @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdBy       String                @db.Uuid
  updatedBy       String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("vacation_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-012 — ausencias: permisos + licencias médicas, UNIFIED (one Absence model,
// category PERMISO|LICENCIA). Permit types are configurable (seeded with the
// Chilean legal set). Licencias médicas are REGISTERED ONLY — NO subsidy/payment
// calc anywhere. Availability blocking is SOFT: a read-only marker (an APROBADO
// absence with blocksAvailability covering a date). NO Operations integration in
// V1 — real enforcement is HR-016. RLS + audit + GRANT shipped in the migration.
// ASCII enums.
// ─────────────────────────────────────────────────────────────────────────

enum AbsenceCategory {
  PERMISO
  LICENCIA
}

enum AbsenceDayUnit {
  CORRIDOS
  HABILES
  MEDIO_DIA
  HORAS
}

enum AbsenceStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  CANCELADO
}

model AbsenceType {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  name        String
  category    AbsenceCategory @default(PERMISO)
  daysDefault Int?
  unit        AbsenceDayUnit  @default(HABILES)
  withPay     Boolean         @default(true)
  isLegal     Boolean         @default(false)
  active      Boolean         @default(true)
  createdBy   String          @db.Uuid
  updatedBy   String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  absences Absence[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("absence_types")
}

model Absence {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  employeeId         String          @db.Uuid
  category           AbsenceCategory
  absenceTypeId      String?         @db.Uuid // permisos reference a type; licencias may not
  startDate          DateTime        @db.Date
  endDate            DateTime        @db.Date
  dias               Int // informational day count (admin-set or computed); NOT a balance
  withPay            Boolean         @default(true)
  blocksAvailability Boolean         @default(true)
  status             AbsenceStatus   @default(PENDIENTE)
  // licencia-specific (nullable; only used when category = LICENCIA). NO subsidy calc.
  medicalFolio       String?
  healthEntity       String? // Isapre/Fonasa — free text
  requestedBy        String?         @db.Uuid
  approvedBy         String?         @db.Uuid
  approvedAt         DateTime?
  rejectionReason    String?
  notes              String?
  documentId         String?         @db.Uuid // optional supporting certificate / licencia PDF
  createdBy          String          @db.Uuid
  updatedBy          String?         @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  absenceType AbsenceType?      @relation(fields: [absenceTypeId], references: [id], onDelete: SetNull)
  document    EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("absences")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-008 — payroll parameters (Nivel A: STORE + EXPOSE only; NO liquidación calc
// engine, NO impuesto-único bracket table — both V2). PERIOD-VERSIONED: a
// PayrollParameterSet is valid for [effectiveFrom, effectiveTo]; AFP comisiones
// belong to a set. Every tope/tasa here is DATA (configurable per period) — never
// hardcode a value in business logic; read it from the set. The seed values
// (HR-008 §3.4, Superintendencia de Pensiones 2026) live in the service seed, not
// in any formula. RLS + audit + GRANT shipped in the migration.
// ─────────────────────────────────────────────────────────────────────────

model PayrollParameterSet {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  name          String // e.g. "2026"
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // null = current/open period

  topeImponibleAfpSaludUf     Decimal  @db.Decimal(8, 2) // 90.00 UF
  topeImponibleAfcUf          Decimal  @db.Decimal(8, 2) // 135.20 UF
  tasaAfpObligatoria          Decimal  @db.Decimal(6, 3) // 10.000 %
  tasaSalud                   Decimal  @db.Decimal(6, 3) // 7.000 %
  tasaAfcIndefinidoTrabajador Decimal  @db.Decimal(6, 3) // 0.600 %
  tasaAfcIndefinidoEmpleador  Decimal  @db.Decimal(6, 3) // 2.400 %
  tasaAfcPlazoFijoEmpleador   Decimal  @db.Decimal(6, 3) // 3.000 %
  tasaSis                     Decimal? @db.Decimal(6, 3) // ~1.530 % (employer; editable)

  active    Boolean  @default(true)
  notes     String?
  createdBy String   @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  afpRates AfpRate[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("payroll_parameter_sets")
}

model AfpRate {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  parameterSetId String  @db.Uuid
  afpName        String
  // nullable: the comisiones we couldn't verify are left null for the admin to fill.
  comisionPorcentaje Decimal? @db.Decimal(6, 3)
  active             Boolean  @default(true)
  createdBy          String   @db.Uuid
  updatedBy          String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parameterSet PayrollParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Cascade)

  @@unique([parameterSetId, afpName])
  @@index([companyId])
  @@map("afp_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-009 — registro de remuneraciones: RECORD settlements computed ELSEWHERE.
// The system STORES + DISPLAYS them; it does NOT compute the liquidación (V2).
// ALL monetary fields are ENTERED by the admin (Decimal 18,2). costoEmpresa is a
// SUM of entered values (totalHaberes + employer aportes), NOT a previsional
// derivation — computed on read. The signed PDF is UPLOADED (HR-004 documentId),
// never generated. SALARY-SENSITIVE: per-person amounts are gated at the API on
// the EmployeeCompensation guard (read+update → MANAGER/ADMIN/SUPER_ADMIN);
// ACCOUNTANT gets aggregates only. RLS + audit + GRANT shipped in the migration.
// ─────────────────────────────────────────────────────────────────────────

enum SettlementStatus {
  BORRADOR
  EMITIDA
  PAGADA
  ANULADA
}

model PayrollSettlement {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @db.Uuid
  employeeId  String @db.Uuid
  periodYear  Int
  periodMonth Int // 1..12 (validated at the service)

  // Haberes (entered)
  haberesImponibles   Decimal  @db.Decimal(18, 2)
  haberesNoImponibles Decimal  @db.Decimal(18, 2)
  sueldoBase          Decimal? @db.Decimal(18, 2) // optional breakdown
  gratificacion       Decimal? @db.Decimal(18, 2) // optional breakdown
  totalHaberes        Decimal  @db.Decimal(18, 2)

  // Descuentos (entered)
  descUAfp          Decimal @db.Decimal(18, 2)
  descSalud         Decimal @db.Decimal(18, 2)
  descAfc           Decimal @db.Decimal(18, 2)
  descImpuestoUnico Decimal @db.Decimal(18, 2)
  otrosDescuentos   Decimal @db.Decimal(18, 2)
  totalDescuentos   Decimal @db.Decimal(18, 2)

  liquidoPagado Decimal @db.Decimal(18, 2) // entered take-home

  // Employer-side contributions (entered, not derived) — summed into costoEmpresa
  aporteAfcEmpleador    Decimal? @db.Decimal(18, 2)
  aporteSis             Decimal? @db.Decimal(18, 2)
  aporteMutual          Decimal? @db.Decimal(18, 2)
  otrosAportesEmpleador Decimal? @db.Decimal(18, 2)
  // MAY be stored; the canonical value is the SUM computed on read.
  costoEmpresa          Decimal? @db.Decimal(18, 2)

  afpName    String? // the AFP used this period (free text / from compensation)
  status     SettlementStatus @default(BORRADOR)
  documentId String?          @db.Uuid // UPLOADED signed PDF (EmployeeDocument) — not generated
  notes      String?

  createdBy String   @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeId, periodYear, periodMonth])
  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("payroll_settlements")
}

// ─────────────────────────────────────────────────────────────────────────
// HR-010 — estimación de finiquito. The CALCULATOR (/estimate) is EPHEMERAL and
// writes NOTHING; only the explicit "registrar finiquito" action persists a
// TerminationRecord. This is an ESTIMATION, not the definitive legal finiquito
// (a disclaimer is returned with every estimation). Acotado arithmetic: dual cap
// (11 años + 90 UF) on IAS/aviso, feriado at full base (no cap), causal drives
// which components apply, UF is an EDITABLE input (no live feed). NO tax/recargos
// in V1. SALARY-SENSITIVE: gated at the API on the TerminationSimulation guard
// (read+update → MANAGER/ADMIN/SUPER_ADMIN). RLS + audit + GRANT in the migration.
// ─────────────────────────────────────────────────────────────────────────

enum TerminationCausal {
  NECESIDADES_EMPRESA // Art. 161 → IAS + aviso (if no notice) + feriado
  DESAHUCIO_EMPLEADOR // Art. 161 (confianza) → same régimen as necesidades
  RENUNCIA // Art. 159 N°2 → feriado proporcional only
  MUTUO_ACUERDO // Art. 159 N°1 → feriado proporcional only
  CADUCIDAD_ART160 // Art. 160 → feriado proporcional only (no IAS)
  PLAZO_FIJO_TERMINO // término de plazo/obra → feriado proporcional only
}

enum TerminationStatus {
  REGISTRADO
  ANULADO
}

model TerminationRecord {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  employeeId      String            @db.Uuid
  causal          TerminationCausal
  terminationDate DateTime          @db.Date
  ufValueUsed     Decimal           @db.Decimal(12, 4) // editable input snapshot (no live UF feed)
  baseMonthlyUsed Decimal           @db.Decimal(18, 2)
  aniosServicio   Int
  aniosIndemnizables Int
  montoIas        Decimal           @db.Decimal(18, 2)
  montoAvisoPrevio Decimal          @db.Decimal(18, 2)
  feriadoDias     Decimal           @db.Decimal(6, 2)
  montoFeriado    Decimal           @db.Decimal(18, 2)
  montoTotal      Decimal           @db.Decimal(18, 2)
  avisoPrevioDado Boolean
  status          TerminationStatus @default(REGISTRADO)
  notes           String?
  createdBy       String            @db.Uuid
  updatedBy       String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, employeeId])
  @@map("termination_records")
}
