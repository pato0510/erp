{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["type:app", "scope:frontend"],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "NODE_ENV=production next build"
      },
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.next/!(cache)/**/*", "{projectRoot}/.next/!(cache)"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/web",
        "command": "next dev"
      }
    }
  }
}
