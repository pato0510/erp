# ─── General ────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=excelsia_dev
POSTGRES_USER=excelsia
POSTGRES_PASSWORD=excelsia_dev_password
DATABASE_URL=postgresql://excelsia:excelsia_dev_password@localhost:5432/excelsia_dev?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── MinIO (S3-compatible storage) ──────────────────────
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=excelsia-documents
MINIO_USE_SSL=false

# ─── Sentry ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── JWT / Auth ─────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=8h
COOKIE_DOMAIN=localhost
