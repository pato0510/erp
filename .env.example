# ─── General ────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
APP_VERSION=1.0.0

# ─── PostgreSQL ─────────────────────────────────────────
# The DATABASE_URL user (excelsia) has BYPASSRLS for migrations.
# RLS policies enforce data isolation at the database level.
# The app sets SET LOCAL rls.company_id per transaction to scope queries.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=excelsia_dev
POSTGRES_USER=excelsia
POSTGRES_PASSWORD=excelsia_dev_password
DATABASE_URL=postgresql://excelsia:excelsia_dev_password@localhost:5432/excelsia_dev?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── MinIO (S3-compatible storage) ──────────────────────
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=excelsia-documents
MINIO_USE_SSL=false

# ─── Sentry ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Security (SEC-001) ─────────────────────────────────
# FRONTEND_URL — the only origin allowed by CORS. Must match the public URL
# of the Next.js app exactly (scheme + host + port). Required for HttpOnly
# cookie auth to work in browsers (credentials cannot be sent to wildcards).
# Default matches `next dev` (port 3000). The API lives on 3001.
FRONTEND_URL=http://localhost:3000

# Global per-IP rate limit applied by ThrottlerGuard. TTL is in seconds.
# Auth endpoints override these with stricter values:
#   POST /api/auth/login   → 5/min
#   POST /api/auth/refresh → 10/min
# GET /api/health is exempt (monitoring probes).
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── JWT / Auth ─────────────────────────────────────────
# JWT_SECRET and REFRESH_TOKEN_SECRET must be rotated out of the defaults
# before any non-dev deployment — they sign auth cookies, so leaking them
# lets an attacker impersonate any user. Use a ≥32-byte random value.
# COOKIE_DOMAIN controls where the HttpOnly auth cookie is accepted; must
# match the frontend domain in prod.
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=your_refresh_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
