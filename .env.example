# ═══════════════════════════════════════════════════════════════════════════
# Excelsia ERP — environment template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in the values. NEVER commit a real .env.
# For production, see docs/DEPLOYMENT.md for the complete go-live checklist.
# ═══════════════════════════════════════════════════════════════════════════

# ─── General ────────────────────────────────────────────
# NODE_ENV controls Nest/Next runtime behavior: logging verbosity, error
# stack traces, source maps, and — most importantly — the `secure` flag on
# auth cookies (HTTPS only in production). ALWAYS set to `production` on
# prod deployments.
#   Dev:  NODE_ENV=development
#   Prod: NODE_ENV=production
NODE_ENV=development

# Port the NestJS API listens on. Internal — put a reverse proxy in front.
API_PORT=3001

# Version string returned by GET /api/health. Bump on each release.
APP_VERSION=1.0.0

# ─── PostgreSQL ─────────────────────────────────────────
# The DATABASE_URL user (excelsia) has BYPASSRLS for migrations.
# RLS policies enforce data isolation at the database level.
# The app sets SET LOCAL rls.company_id per transaction to scope queries.
# In production: rotate POSTGRES_PASSWORD, restrict DB network to the API
# node, and run migrations as a separate superuser while the app runs as
# a less-privileged role.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=excelsia_dev
POSTGRES_USER=excelsia
POSTGRES_PASSWORD=excelsia_dev_password
DATABASE_URL=postgresql://excelsia:excelsia_dev_password@localhost:5432/excelsia_dev?schema=public

# ─── Redis ──────────────────────────────────────────────
# Used by BullMQ (bank sync jobs, tax sync) and rate limiting (ThrottlerModule
# uses in-memory by default; for multi-node deploys switch to a Redis store).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── MinIO (S3-compatible storage) ──────────────────────
# Stores imported cartolas, movement imports, and document artifacts.
# In production, rotate MINIO_ROOT_USER/PASSWORD and set MINIO_USE_SSL=true
# behind the reverse proxy. Consider using real S3 in AWS regions.
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=excelsia-documents
MINIO_USE_SSL=false

# ─── Sentry ─────────────────────────────────────────────
# SENTRY_DSN is required in production for error observability. Leave blank
# in dev to silence the SDK. SENTRY_AUTH_TOKEN is only needed at build time
# if you want to upload source maps (recommended in prod).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Security (SEC-001) ─────────────────────────────────
# FRONTEND_URL — the only origin allowed by CORS. Must match the public URL
# of the Next.js app exactly (scheme + host + port). Required for HttpOnly
# cookie auth to work in browsers (credentials cannot be sent to wildcards).
# Default matches `next dev` (port 3000). The API lives on 3001.
# In production: FRONTEND_URL=https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# Global per-IP rate limit applied by ThrottlerGuard. TTL is in seconds.
# Auth endpoints override these with stricter values:
#   POST /api/auth/login   → 5/min
#   POST /api/auth/refresh → 10/min
# GET /api/health is exempt (monitoring probes).
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── JWT / Auth ─────────────────────────────────────────
# JWT_SECRET and REFRESH_TOKEN_SECRET MUST be rotated out of the defaults
# before any non-dev deployment — they sign auth cookies, so leaking them
# lets an attacker impersonate any user. Use a ≥32-byte random value, e.g.
#   $ openssl rand -base64 48
# COOKIE_DOMAIN controls where the HttpOnly auth cookie is accepted; must
# match the frontend domain in prod (e.g. `.yourdomain.com` to share across
# api.yourdomain.com and app.yourdomain.com).
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=your_refresh_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# ─── Frontend (Next.js) ─────────────────────────────────
# Base URL the browser uses to reach the API. In development this is
# the localhost API port; in production it should point to the public
# API origin (e.g. https://api.yourdomain.com).
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── SII / LibreDTE (SII-001) ───────────────────────────
# LibreDTE credentials are obtained from https://libredte.cl (API hash + key).
# APP_SECRET is used to derive a 32-byte AES-256-GCM key that encrypts the
# .pfx certificate password in the DB. Rotating it invalidates stored
# passwords — users will need to re-upload their certificates. Use a value
# with ≥32 chars of entropy, e.g. `openssl rand -hex 32`.
# SII_CERT_BUCKET is the MinIO/S3 bucket where .pfx files are stored under
# `sii/{companyId}/certificate.pfx`.
LIBREDTE_API_HASH=your_api_hash_here
LIBREDTE_API_KEY=your_api_key_here
LIBREDTE_BASE_URL=https://libredte.cl/api
APP_SECRET=random_32_char_string_for_encryption
SII_CERT_BUCKET=excelsia-documents

# ─── BaseAPI (SII-002) ──────────────────────────────────
# BaseAPI is the current SII integration provider. Get a key from
# https://baseapi.cl. SII_RUT/SII_PASSWORD correspond to the company's SII
# portal credentials and are sent in the request body (BaseAPI proxies them
# to the SII backend). When a per-company SiiConnection row is set, those
# values win; these env vars are the fallback for single-tenant deployments.
BASEAPI_KEY=your_baseapi_key_here
BASEAPI_BASE_URL=https://api.baseapi.cl/api/v1
SII_RUT=77004647-5
SII_PASSWORD=your_sii_portal_password

# ─── Operations Dashboard (OPS-034) ─────────────────────
# When `true` (or unset), the operations dashboard reads pre-computed
# materialized views (refreshed every 15min/1h by BullMQ + on selected
# domain events). Setting this to `false` forces every read to re-run
# the live aggregation queries — useful for parity verification or
# when debugging a stale-data complaint.
DASHBOARD_USE_MATERIALIZED_VIEWS=true
