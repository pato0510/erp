# syntax=docker/dockerfile:1.7
# ═══════════════════════════════════════════════════════════════════════════
# Excelsia ERP — API (NestJS) production image
# ═══════════════════════════════════════════════════════════════════════════
# Multi-stage: deps → build → runner. The runner layer contains only the
# compiled dist, pruned node_modules, and the Prisma schema folder so
# `prisma migrate deploy` can run from inside the container at boot.
# ═══════════════════════════════════════════════════════════════════════════

FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./
COPY nx.json ./
COPY tsconfig*.json ./

FROM base AS deps
RUN npm ci --only=production

FROM base AS build
RUN npm ci
COPY . .
RUN npx nx build api --prod
RUN npm prune --production

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist/apps/api ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/prisma ./prisma
EXPOSE 3001
CMD ["node", "dist/main.js"]
