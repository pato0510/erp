# syntax=docker/dockerfile:1.7
# ═══════════════════════════════════════════════════════════════════════════
# Excelsia ERP — Web (Next.js) production image
# ═══════════════════════════════════════════════════════════════════════════
# Uses Next.js `output: 'standalone'` (set in apps/web/next.config.js) so the
# runner layer only needs the standalone server, the `.next/static` assets,
# and the `public` folder — no full node_modules.
# ═══════════════════════════════════════════════════════════════════════════

FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./
COPY nx.json ./
COPY tsconfig*.json ./

FROM base AS deps
RUN npm ci --only=production

FROM base AS build
RUN npm ci
COPY . .
RUN npx nx build web --prod
RUN npm prune --production

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
